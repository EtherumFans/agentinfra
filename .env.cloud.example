# iCoDer Cloud Deployment — Environment Variables Template
# Date: 2026-06-27 (Phase 1 cloud-flip)
#
# 用途: 托管云 SaaS 部署。所有 ICODER_* cloud-only vars 在 ICODER_DEPLOYMENT_MODE=cloud
#       时必填。本地开发走 ICODER_DEPLOYMENT_MODE=local (默认),所有 vars optional。
#
# 详见: docs/cloud/CLOUD_DEPLOYMENT.md / docs/cloud/API_CLIENT_MODEL.md

# ── Deployment Mode ─────────────────────────────────────────────────────────
# local  = 本地开发,所有 cloud-only vars optional,sqlite + 自动 seed (默认)
# cloud  = 托管云生产,所有 cloud-only vars 必填
ICODER_DEPLOYMENT_MODE=local

# ── Cloud-Only Required Vars (ICODER_DEPLOYMENT_MODE=cloud 时必填) ──────────
# 托管云 API endpoint (per-tenant): {tenant_slug}.{region}.icoder.cloud
# ICODER_HOSTED_URL=https://api.icoder.cloud

# Environment: eu / us / cn
# ICODER_ENVIRONMENT=cn

# Region: eu-frankfurt / us-virginia / cn-hangzhou / etc.
# 详见 deploy/cloud/regions.yaml
# ICODER_REGION=cn-hangzhou

# Tenant ID (provisioning 时由 iCoDer 运维下发)
# ICODER_TENANT_ID=

# API Client (backend-service flow)
# 创建于 Console → Settings → API Clients
# ICODER_API_CLIENT_ID=
# ICODER_API_CLIENT_SECRET=

# Application signing secret. Inject from KMS/secret manager; never commit a
# generated value. Cloud mode rejects missing or known-weak values.
# ICODER_SECRET_KEY=

# PHI key-provider contract. Approved interim deployments may use the hardened
# encrypted software-HSM key store with documented residual risk. It does not
# provide a certified hardware boundary and should later migrate to KMS/HSM.
# ICODER_PHI_KEY_PROVIDER=software_hsm
# ICODER_SOFT_HSM_KEYSTORE_PATH=/run/secrets/icoder/software-hsm.keys
# ICODER_SOFT_HSM_BOOTSTRAP_KEY=  # base64url 32-byte key; inject separately from key store
# ICODER_SOFT_HSM_MIN_GENERATION=1  # monotonic floor held in deployment configuration
# ICODER_SOFT_HSM_REQUIRE_ENCRYPTED_KEYSTORE=true
# ICODER_SOFT_HSM_OPS_AUDIT_PATH=/var/lib/icoder-audit/software-hsm-ops.jsonl
# ICODER_SOFT_HSM_OPS_AUDIT_KEY=  # independent base64url 32+ byte audit key
# ICODER_SOFT_HSM_OPS_AUDIT_KEY_ID=soft-hsm-ops-audit-v1
# ICODER_SOFT_HSM_OPS_AUDIT_MIN_SEQUENCE=0  # external checkpoint against tail rollback
# ICODER_SOFT_HSM_NEW_BOOTSTRAP_KEY=  # set only during bootstrap rotation
# ICODER_PHI_ENCRYPTION_KEY_V1=  # temporary legacy read key during v1→v2 only

# Dedicated per-pod process-metrics scrape credential (32-512 characters).
# Inject from KMS/Secret Manager; never use a tenant OAuth credential here.
# ICODER_METRICS_BEARER_TOKEN=

# Cloud must use a DB-backed RunTrace store. BEST_EFFORT_DB keeps business
# operations available during a transient trace-write failure; regulated
# deployments that require "no trace left behind" must select REQUIRED_DB and
# RUNTRACE_FAIL_CLOSED=1 through their managed environment configuration.
RUNTRACE_STORE=db
RUNTRACE_FAIL_CLOSED=0
RUNTRACE_DEPLOYMENT_PROFILE=BEST_EFFORT_DB
ICODER_RUN_TRACE_EVENTS_TTL_DAYS=90
ICODER_RUN_HISTORY_TTL_DAYS=90

# ── Application Settings (云端 vs local 略有不同) ───────────────────────────
APP_ENV=cloud
ICODER_ENABLE_PROTOCOL_FIXTURES=0
DEBUG=false
ICODER_DATABASE_SQL_ECHO=false
# Cross-worker Streams ownership TTL; runtime accepts only the bounded 6..300s range.
ICODER_STREAM_LEASE_SECONDS=30
# Streams media is decoded in the bounded ffmpeg subprocess before ASR or retention.
ICODER_STREAM_MEDIA_VALIDATION_MODE=decoder
ICODER_STREAM_MEDIA_DECODER_PATH=/usr/bin/ffmpeg
ICODER_STREAM_MEDIA_DECODER_TIMEOUT_SECONDS=3
ICODER_STREAM_MEDIA_DECODER_MAX_CONCURRENCY=2
ICODER_STREAM_MEDIA_DECODER_QUEUE_TIMEOUT_SECONDS=0.5
ICODER_TRANSCRIPTS_MEDIA_DECODER_PATH=/usr/bin/ffmpeg
ICODER_TRANSCRIPTS_MEDIA_PROBE_PATH=/usr/bin/ffprobe
ICODER_TRANSCRIPTS_MEDIA_DECODER_TIMEOUT_SECONDS=120
ICODER_TRANSCRIPTS_MEDIA_PROBE_TIMEOUT_SECONDS=10
ICODER_TRANSCRIPTS_MEDIA_DECODER_MAX_CONCURRENCY=2
ICODER_TRANSCRIPTS_MEDIA_DECODER_QUEUE_TIMEOUT_SECONDS=1
ICODER_TRANSCRIPTS_MAX_DURATION_SECONDS=7200
OAUTH_REQUIRE_TENANT_HEADER=true

# Database (cloud: managed Postgres)
# DATABASE_URL=postgresql+asyncpg://icoder:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

# CORS (cloud: 必须列出所有前端域名)
# CORS_ORIGINS=["https://app.icoder.cloud"]

# 不再 auto-seed admin/admin123 (云端安全)
SEED_ON_STARTUP=false

# ── PHI & Audit ─────────────────────────────────────────────────────────────
# edge: PHI 强制脱敏后入云审计通道 (cloud 默认)
# disabled: 仅 local dev 允许
ICODER_PHI_REDACTION_MODE=edge

# cloud_audit: audit log 入云 object storage (cloud 默认)
# local: 仅写本地 (Phase 1 默认行为)
ICODER_AUDIT_SINK=cloud_audit

# ── Organization invitation delivery ───────────────────────────────────────
# Cloud forbids manual return of invitation credentials. The regional
# notification service receives a signed/idempotent HTTPS webhook and sends
# the hospital-approved email template. Inject the bearer token from KMS.
ICODER_INVITE_DELIVERY_MODE=webhook
# ICODER_INVITE_WEBHOOK_URL=https://notification.cn-hangzhou.internal/invitations
# ICODER_INVITE_WEBHOOK_BEARER_TOKEN=  # 32-512 chars, inject from KMS
ICODER_INVITE_ALLOWED_EMAIL_DOMAINS=["hospital.example.cn"]
ICODER_INVITE_MAX_ATTEMPTS=5
ICODER_INVITE_RETRY_BASE_SECONDS=30
ICODER_INVITE_CLAIM_TIMEOUT_SECONDS=120
ICODER_INVITE_WEBHOOK_TIMEOUT_SECONDS=10

# ── LLM Provider (per-tenant, 走云 KMS 注入) ────────────────────────────────
# Supported runtime values: deepseek | qwen | openai_compat | local | mock.
# qwen/openai_compat/local must use a matching OpenAI-compatible endpoint;
# obvious provider/endpoint mismatches fail closed. mock is development-only.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
# ICODER_CREDENTIAL_LLM=  # inject from KMS; CredentialVault ingress
LLM_BASE_URL=https://api.deepseek.com/v1
# Runtime network calls are denied unless both the external-provider switch
# and the regional egress decision allow them. ICODER_REGION is the coarse
# data-residency boundary (cn/eu/us), not the cloud availability-zone code.
ICODER_ALLOW_EXTERNAL_LLM=false
ICODER_REGION=cn
ICODER_EGRESS_POLICY=strict
# Agentic MCP/A2A Connector egress is a separate, exact-host boundary. An
# empty allowlist means every remote Connector remains fail-closed. Redirects
# are independently denied by default in each Connector config.
# Public registry Providers additionally require their exact official hosts in
# this allowlist. PubMed follows NCBI E-utilities policy and also requires a
# non-secret operational contact email; it remains unavailable when omitted.
# ICODER_CONNECTOR_EGRESS_ALLOWLIST=mcp.partner.example.cn,a2a.partner.example.cn,auth.partner.example.cn,eutils.ncbi.nlm.nih.gov,clinicaltrials.gov
# ICODER_NCBI_CONTACT_EMAIL=api-operations@hospital.example.cn
# Licensed/privacy Registry gateways implement the iCoDer v1 gateway contract.
# URLs are server-owned HTTPS endpoints; credentials must be injected from KMS.
# ICODER_DRUGBANK_GATEWAY_URL=https://registry-gateway.hospital.example.cn/drugbank/query
# ICODER_CREDENTIAL_DRUGBANK=
# ICODER_POSOS_GATEWAY_URL=https://registry-gateway.hospital.example.cn/posos/query
# ICODER_CREDENTIAL_POSOS=
# ICODER_WEB_SEARCH_GATEWAY_URL=https://search-gateway.hospital.example.cn/query
# ICODER_CREDENTIAL_WEB_SEARCH=
# ICODER_WEB_SEARCH_PROVIDER_OPT_IN=false
# ICODER_WEB_SEARCH_TENANT_OPT_IN_ORGANIZATIONS=org_example1
# Semantic Memory embeddings run outside the API native process. Cloud release
# profiles should require the service; URL host must also be in the egress list.
# ICODER_MEMORY_SEMANTIC_URL=https://memory-embedding.example.cn/v1/embed
# ICODER_CREDENTIAL_MEMORY_SEMANTIC=
# ICODER_MEMORY_SEMANTIC_REQUIRED=true
# PHI/restricted Connector payloads require both the explicit switch and a
# narrower exact-host list; keep disabled unless hospital security/legal have
# approved the destination and purpose of use.
ICODER_CONNECTOR_ALLOW_PHI=false
# ICODER_CONNECTOR_PHI_EGRESS_ALLOWLIST=mcp.partner.example.cn
# Bound Connector credentials resolve through CredentialVault by the
# fingerprint returned by the credential-bind API. Example only (never commit):
# ICODER_CREDENTIAL_CONNECTOR_0123456789ABCDEF=  # inject from KMS/secret manager
# External connectivity canary is off until the hospital security/model owner
# explicitly approves the fixed no-patient-data request and cost policy.
ICODER_MODEL_LIVE_CANARY_ENABLED=false
ICODER_MODEL_LIVE_CANARY_MAX_COST_CNY=0.05
ICODER_MODEL_LIVE_CANARY_MAX_OUTPUT_TOKENS=8
ICODER_MODEL_LIVE_CANARY_TIMEOUT_SECONDS=15
ICODER_MODEL_LIVE_CANARY_COOLDOWN_SECONDS=300
# Examples when approved by the hospital security owner:
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ICODER_PROVIDER_REGION_OPENAI_COMPAT=cn  # required for a reviewed CN generic endpoint
# Optional additional operator-approved deployments. This JSON contains only
# metadata and credential ENVIRONMENT VARIABLE NAMES, never credential values.
# External endpoints must use HTTPS; malformed/duplicate/reserved deployments
# fail cloud startup. A tenant owner/admin may pin only entries registered here.
# ICODER_CREDENTIAL_LLM_QWEN_CN_A=  # inject from KMS
# ICODER_LLM_DEPLOYMENTS_JSON=[{"id":"qwen-cn-a","provider":"qwen","model":"qwen-plus","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","credential_env":"ICODER_CREDENTIAL_LLM_QWEN_CN_A","tenant_selectable":true}]

# ── Asset Storage (S3-compatible, region-scoped) ────────────────────────────
# 代码字典 / FAISS 索引 / KB 资源从 region bucket 加载
# ICODER_ASSET_BUCKET=icoder-assets-cn-hangzhou

# Cloud tenant identity must always come from the authenticated request.
ICODER_SINGLE_TENANT_ORG_ID=

# ── Local Dev Override (可选) ───────────────────────────────────────────────
# 本地开发可显式覆盖 DATABASE_URL 为 sqlite:
# DATABASE_URL=sqlite+aiosqlite:///./data/icoder.db
# ICODER_DEPLOYMENT_MODE=local 自动启用以下:
#   - SEED_ON_STARTUP=true
#   - ICODER_PHI_REDACTION_MODE=disabled
#   - ICODER_AUDIT_SINK=local

# ── Isolated MedCodER Retrieval Service ────────────────────────────────────
# Cloud mode requires a separately deployed/scanned Linux BGE+FAISS worker.
# The API image never installs or imports Torch, sentence-transformers or FAISS.
# MEDCODER_RETRIEVER_URL=https://medcoder-retriever.cn-hangzhou.internal
# MEDCODER_RETRIEVER_TOKEN=  # inject a 32+ character service token from KMS
MEDCODER_RETRIEVER_ALLOW_HTTP=false
MEDCODER_RETRIEVER_TIMEOUT_SECONDS=15
# MEDCODER_SUBPROCESS and local BGE knobs are development-only and forbidden
# as the cloud semantic-retrieval path.

# E1.8 Stage 1 few-shot exemplars (P1.0-A) — DEFAULT OFF.
# E2.0 5-case smoke showed no F1@1 improvement and F1@5 regression on the
# baseline slice. Set to "true" ONLY for the coding-quality project
# (see docs/backlog/CODING_QUALITY_BACKLOG.md).
# ICODER_EXPERIMENTAL_MEDCODER_FEWSHOT=false
