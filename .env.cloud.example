# iCoDer Cloud Deployment — Environment Variables Template
# Date: 2026-06-27 (Phase 1 cloud-flip)
#
# 用途: 托管云 SaaS 部署。所有 ICODER_* cloud-only vars 在 ICODER_DEPLOYMENT_MODE=cloud
#       时必填。本地开发走 ICODER_DEPLOYMENT_MODE=local (默认),所有 vars optional。
#
# 详见: docs/cloud/CLOUD_DEPLOYMENT.md / docs/cloud/API_CLIENT_MODEL.md

# ── Deployment Mode ─────────────────────────────────────────────────────────
# local  = 本地开发,所有 cloud-only vars optional,sqlite + 自动 seed (默认)
# cloud  = 托管云生产,所有 cloud-only vars 必填
ICODER_DEPLOYMENT_MODE=local

# ── Cloud-Only Required Vars (ICODER_DEPLOYMENT_MODE=cloud 时必填) ──────────
# 托管云 API endpoint (per-tenant): {tenant_slug}.{region}.icoder.cloud
# ICODER_HOSTED_URL=https://api.icoder.cloud

# Environment: eu / us / cn
# ICODER_ENVIRONMENT=cn

# Region: eu-frankfurt / us-virginia / cn-hangzhou / etc.
# 详见 deploy/cloud/regions.yaml
# ICODER_REGION=cn-hangzhou

# Tenant ID (provisioning 时由 iCoDer 运维下发)
# ICODER_TENANT_ID=

# API Client (backend-service flow)
# 创建于 Console → Settings → API Clients
# ICODER_API_CLIENT_ID=
# ICODER_API_CLIENT_SECRET=

# ── Application Settings (云端 vs local 略有不同) ───────────────────────────
APP_ENV=cloud
DEBUG=false

# Database (cloud: managed Postgres)
# DATABASE_URL=postgresql+asyncpg://icoder:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

# CORS (cloud: 必须列出所有前端域名)
# CORS_ORIGINS=["https://app.icoder.cloud"]

# 不再 auto-seed admin/admin123 (云端安全)
SEED_ON_STARTUP=false

# ── PHI & Audit ─────────────────────────────────────────────────────────────
# edge: PHI 强制脱敏后入云审计通道 (cloud 默认)
# disabled: 仅 local dev 允许
ICODER_PHI_REDACTION_MODE=edge

# cloud_audit: audit log 入云 object storage (cloud 默认)
# local: 仅写本地 (Phase 1 默认行为)
ICODER_AUDIT_SINK=cloud_audit

# ── LLM Provider (per-tenant, 走云 KMS 注入) ────────────────────────────────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=  # 注入云 KMS,不进文件
LLM_BASE_URL=https://api.deepseek.com/v1

# ── Asset Storage (S3-compatible, region-scoped) ────────────────────────────
# 代码字典 / FAISS 索引 / KB 资源从 region bucket 加载
# ICODER_ASSET_BUCKET=icoder-assets-cn-hangzhou

# ── Local Dev Override (可选) ───────────────────────────────────────────────
# 本地开发可显式覆盖 DATABASE_URL 为 sqlite:
# DATABASE_URL=sqlite+aiosqlite:///./data/icoder.db
# ICODER_DEPLOYMENT_MODE=local 自动启用以下:
#   - SEED_ON_STARTUP=true
#   - ICODER_PHI_REDACTION_MODE=disabled
#   - ICODER_AUDIT_SINK=local

# ── MedCodER Runtime Knobs ──────────────────────────────────────────────────
# Memory knobs (E1.9) — defaults shown.
# MEDCODER_BGE_DTYPE=float16
# MEDCODER_BGE_DEVICE=cpu
# MEDCODER_SUBPROCESS=1  # Windows-spawn-safe worker

# E1.8 Stage 1 few-shot exemplars (P1.0-A) — DEFAULT OFF.
# E2.0 5-case smoke showed no F1@1 improvement and F1@5 regression on the
# baseline slice. Set to "true" ONLY for the coding-quality project
# (see docs/backlog/CODING_QUALITY_BACKLOG.md).
# ICODER_EXPERIMENTAL_MEDCODER_FEWSHOT=false