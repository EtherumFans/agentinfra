*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Node
node_modules/
frontend/dist/
web-components/dist/
sdk/dist/

# E2E auth state (contains real tokens)
**/tests/e2e/.auth.json

# Phase 2 cycle 20 — toolchain-generated Playwright specs.
# scripts/icoder_ui_diff.py writes these into frontend/tests/e2e/_runtime/
# on every runtime check (one file per check), then deletes them in finally.
# This entry is a safety net in case cleanup fails (e.g. Ctrl-C).
frontend/tests/e2e/_runtime/

# Build artifacts
*.log
*.db
backend/data/*.db

# Test artifacts
frontend/playwright-report/
frontend/test-results/
htmlcov/
.coverage
coverage.xml

# Screenshots and research
screenshots/
backend/screenshots/
Corti/

# Corti reverse-engineering artifacts (28MB of HTML/PNG crawl output;
# contains unredacted screenshots — keep crawlers + analyzers in git,
# exclude the binary bulk). Re-generated by scripts/corti_*.py on demand.
docs/corti-reverse-engineered/

# Transient QA screenshots and Playwright MCP cache
.playwright-mcp/
artifacts/
medical-coding-input.png
backend/med-coding-input.png
backend/_med-input-view.png

