*.bak
*.tmp

# Windows recycle bin
$RECYCLE.BIN/

# Data files
*.xlsx

backend/marketplace_data/

# iCoDer runtime state (regenerated on every test run)
# Keeps agent registry + m2a trace store out of source control.
# Originally tracked (commits prior to Phase D) — preserved on disk
# via `git rm --cached` (D cleanup 2026-06-26).
backend/.icoder/
.icoder/

# MedCodER retrieval assets (rebuilt by scripts/build_medcoder_index.py)
# Keep README and build scripts, but ignore the heavy binary outputs.
backend/data/medcoder/faiss.index
backend/data/medcoder/faiss_icd9cm3.index
backend/data/medcoder/metadata.pkl
backend/data/medcoder/metadata_icd9cm3.pkl
backend/data/medcoder/models/
backend/data/medcoder/*.log
!backend/data/medcoder/README.md

# MedCodER eval ablation scratch (transient smoke runs; not reproducible artifacts)
backend/data/medcoder/eval_smoke*.json

