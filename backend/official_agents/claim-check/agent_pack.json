  "non_goals": [
    "不调用医保、商保、编码、HCC或DRG/DIP外部服务",
    "不判断编码或费用是否有病历支持",
    "不判断医疗必要性、待遇资格、支付或拒付结论",
    "不修改编码、结算清单或病历，不自动提交"
  ],
  "human_review_required_when": [
    "every result before claim submission or coding change",
    "claim, chart evidence, payer policy, region, version, effective date, or source is missing or conflicting"
  ],
  "example_inputs": [
