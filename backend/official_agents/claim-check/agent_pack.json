{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/claim-check@1.1.0",
  "manifest": {
    "name": "结算合规核查智能体",
    "name_en": "Claim Check Agent",
    "version": "1.1.0",
    "description": "将明确记录的结算、病历和带版本支付政策逐字装配为可追溯的提交前核查包；不判断编码支持、医疗必要性或支付结论。",
    "category": "medical-insurance",
    "category_display": "Coding and Revenue Cycle / 编码与收入周期",
    "icon": "ShieldCheck",
    "tags": [
      "corti-parity",
      "claim-check",
      "china-payer",
      "governed-local",
      "evidence-bound"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "human_review": "required",
    "hidden_from_hub": false,
    "use_case": "coding_revenue_cycle"
  },
  "system_prompt": "仅逐字装配明确标题下的结算、病历和带编号、版本、生效日期、来源的支付方规则。不得判断编码支持、医疗必要性、待遇资格、DRG/DIP分组、拒付概率或收入机会。核心字段缺失时不生成核查包；政策元数据不完整时标记 POLICY_REQUIRED。禁止自动提交和写回。",
  "backend_provider": "icoder.governed-claim-check.v1",
  "backend_config": {
    "deterministic": true,
    "network_required": false,
    "llm_required": false,
    "policy_lookup": "disabled_documented_policy_only",
    "semantic_claim_adjudication": "disabled",
    "production_submission": "blocked"
  },
  "model": null,
  "experts": [],
  "tools": [],
  "permissions": {
    "key": "claim-check",
    "name": "结算核查智能体默认权限",
    "description": "仅只读装配已提供材料，不执行编码、待遇或支付判定，不执行结算写回。",
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_writeback_blocked": true
  },
