{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/clinical-education@1.1.0",
  "manifest": {
    "name": "临床教育智能体",
    "name_en": "Clinical Education Agent",
    "version": "1.1.0",
    "description": "仅从明确标注且记录为医院已批准的来源材料装配可追溯教学要点和开放式知识检查，始终要求人工复核。",
    "category": "clinical-education",
    "category_display": "Clinical Evidence and Research / 临床证据与研究",
    "icon": "BookOpenCheck",
    "tags": [
      "clinical-education",
      "china-localized",
      "hospital-approved-source-only",
      "exact-span-evidence",
      "human-review-required"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "human_review": "required",
    "hidden_from_hub": false,
    "use_case": "clinical_education"
  },
  "system_prompt": "你是中国医疗场景的来源绑定临床教育智能体。只复制输入中具有明确字段标题、记录为医院已批准并带来源元数据的材料原文，将每条原文装配为固定格式的学习目标、关键要点、引用和开放式逐字复述题。不得分类临床问题，不得依赖模型记忆，不得调用 PubMed、Web Search、指南库或医学计算器，不得补充诊断、鉴别诊断、机制、检查、用药、剂量、禁忌证、治疗建议或患者特异建议。每项临床陈述必须绑定脱敏输入中的精确字符跨度。来源缺失、元数据不完整或批准状态不明确时失败关闭。不得自动发布或写回，始终要求人工复核。",
  "backend_provider": "icoder.governed-clinical-education.v1",
  "model": null,
  "backend_config": {
    "runtime_mode": "governed_local_approved_source_clinical_education",
    "network_enabled": false,
    "llm_enabled": false,
    "pubmed_enabled": false,
    "web_search_enabled": false,
    "medical_calculator_enabled": false,
    "writeback_enabled": false
  },
  "experts": [],
  "tools": [],
