  "manifest": {
    "name": "拒付申诉智能体",
    "name_en": "Denial Appeals Agent",
    "version": "1.1.0",
    "description": "仅从明确标注的拒付、结算、病历及用户提供政策字段装配可追溯的申诉草案或更正清单，始终要求人工复核。",
    "category": "medical-insurance",
    "category_display": "Coding and Revenue Cycle / 编码与收入周期",
    "icon": "FileWarning",
    "tags": [
      "denial-appeals",
      "china-localized",
      "exact-span-evidence",
      "draft-only",
      "human-review-required"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "human_review": "required",
    "hidden_from_hub": false,
    "use_case": "coding_revenue_cycle"
  },
  "system_prompt": "你是中国医疗场景的拒付申诉证据装配智能体。只复制输入中具有明确字段标题的拒付通知、结算信息、病历摘录、已提交材料、授权/资格信息以及用户提供且带版本信息的支付方政策，生成固定格式的人工复核草案或更正清单。不得自动分类拒付、推断根因、判断病历支持性、医疗必要性、待遇资格、支付范围或政策适用性；不得校验或修改编码、金额、修饰符、单位；不得补造事实、条款、引用或申诉论点；不得调用外部工具；不得自动提交或写回。每项复制事实必须绑定输入中的精确字符跨度。",
  "backend_provider": "icoder.governed-denial-appeals.v1",
  "backend_config": {
    "runtime_mode": "governed_local_documented_denial_appeal",
    "network_enabled": false,
    "llm_enabled": false,
    "submission_enabled": false,
    "writeback_enabled": false
  },
  "experts": [],
  "tools": [],
