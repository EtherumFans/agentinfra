{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/diagnosis-extractor@1.2.0",
  "manifest": {
    "name": "诊断提取智能体",
    "version": "1.2.0",
    "description": "从明确诊断标签或明确疑似、否定、既往、家族史修饰中提取逐字证据；仅在固定 SHA-256 的 ICD-10-CN 目录得到唯一可分配条目时生成候选。目录来源与许可待外部核验，始终要求人工复核。",
    "category": "medical-coding",
    "category_display": "Coding and Revenue Cycle / 编码与收入周期",
    "icon": "Stethoscope",
    "tags": [
      "diagnosis-extraction",
      "icd-10-cn",
      "evidence-first",
      "governed-assets",
      "deterministic"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "human_review": "required",
    "hidden_from_hub": false,
    "use_case": "coding_revenue_cycle"
  },
  "system_prompt": "你是 iCoDer 受治理本地诊断实体提取智能体。只允许从出院诊断、入院诊断、主要诊断、明确诊断等标签内提取当前诊断，或从原文明示的考虑/疑似/待排/排除/否认/既往/家族史修饰中提取非当前确诊提及。每项 evidence_text 与 [start,end) char_span 必须逐字回指输入。不得根据药物、检验、手术或一般叙述反推诊断。只有明示当前诊断的精确术语在固定 ICD-10-CN 目录得到唯一可分配条目时才能进入 diagnoses；否则必须作为 unresolved 保留原文，不得猜测或选择子码。疑似、否定、既往、家族史和 unresolved 项只进入 non_codable_mentions。目录 authority_status=source_unverified、license_status=external_review_required、billing_authoritative=false，因此 status 最多为 WARNING，manual_review_required 始终为 true，禁止自动结算和 EMR/HIS 写回。",
  "experts": [],
  "tools": [],
  "backend_provider": "icoder.governed-diagnosis-extractor.v1",
  "backend_config": {
    "explicit_diagnosis_baseline": {
      "asset_id": "cn.icd10cn.catalog",
      "version": "observed-local-2026-05-19",
      "integrity_required": true,
      "network_required": false,
      "llm_required": false,
      "maximum_input_characters": 20000,
      "maximum_items": 100,
      "clinical_diagnosis_assessed": false,
      "billing_authoritative": false
    }
  },
  "model": null,
  "output_contract": {
    "schema_ref": "icoder/DiagnosisExtractionOutput/v7",
    "a2a_parts": [
      "DataPart"
    ],
    "required_fields": [
      "status",
      "diagnoses",
      "non_codable_mentions",
      "issues_found",
      "manual_review_required",
      "trace_refs"
    ],
    "field_definitions": {
      "status": "本地基线仅返回 WARNING 或 REQUIRES_REVIEW；不生成生产 PASS",
      "diagnoses": "仅含明确诊断标签内、具有逐字证据且在固定 ICD-10-CN 目录得到唯一可分配条目的当前诊断候选",
      "non_codable_mentions": "疑似、否定、既往、家族史或无法唯一映射的逐字提及；不得作为当前确诊编码",
      "issues_found": "证据边界、非当前断言和目录治理限制",
      "manual_review_required": "固定为 true，必须由编码员复核",
      "trace_refs": "本地 Provider 执行引用"
    },
    "field_types": {
      "status": "string",
      "diagnoses": "array",
      "non_codable_mentions": "array",
      "issues_found": "array",
      "manual_review_required": "boolean",
      "trace_refs": "object"
    },
    "field_schemas": {
      "status": {
        "type": "string",
        "maxLength": 32768,
        "enum": [
          "PASS",
          "WARNING",
          "REQUIRES_REVIEW"
        ]
      },
      "diagnoses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assertion_status": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "present",
                "suspected",
                "negated",
                "history_of",
                "family_history"
              ]
            },
            "char_span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2,
              "x-order": "nondecreasing"
            },
            "confidence": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "diagnosis_text": {
              "type": "string",
              "maxLength": 32768
            },
            "evidence_text": {
              "type": "string",
              "maxLength": 32768
            },
            "icd10_cn_code": {
              "type": "string",
              "maxLength": 32768
            },
            "icd10_cn_name": {
              "type": "string",
              "maxLength": 32768
            },
            "verification": {
              "type": "string",
              "maxLength": 32768
            }
          },
          "required": [
            "assertion_status",
            "char_span",
            "confidence",
            "diagnosis_text",
            "evidence_text",
            "icd10_cn_code",
            "icd10_cn_name",
            "verification"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "non_codable_mentions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assertion_status": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "suspected",
                "negated",
                "history_of",
                "family_history",
                "unresolved"
              ]
            },
            "char_span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2,
              "x-order": "nondecreasing"
            },
            "evidence_text": {
              "type": "string",
              "maxLength": 32768
            },
            "mention_text": {
              "type": "string",
              "maxLength": 32768
            },
            "reason": {
              "type": "string",
              "maxLength": 32768
            }
          },
          "required": [
            "assertion_status",
            "char_span",
            "evidence_text",
            "mention_text",
            "reason"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "issues_found": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 32768
        },
        "maxItems": 100
      },
      "manual_review_required": {
        "type": "boolean",
        "const": true
      },
      "trace_refs": {
        "type": "object",
        "properties": {
          "provider_trace_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32768
            },
            "maxItems": 100
          },
          "run_id": {
            "type": "string",
            "maxLength": 32768
          },
          "trace_id": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      }
    },
    "field_relations": [
      {
        "id": "codable_diagnosis_requires_current_evidence",
        "for_each": "diagnoses",
        "when": [
          {
            "path": "diagnosis_text",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "assertion_status",
            "operator": "equals",
            "value": "present"
          },
          {
            "path": "icd10_cn_code",
            "operator": "non_empty"
          },
          {
            "path": "icd10_cn_name",
            "operator": "non_empty"
          },
          {
            "path": "evidence_text",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "noncodable_mention_requires_reason",
        "for_each": "non_codable_mentions",
        "when": [
          {
            "path": "mention_text",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "assertion_status",
            "operator": "in",
            "value": [
              "suspected",
              "negated",
              "history_of",
              "family_history",
              "unresolved"
            ]
          },
          {
            "path": "evidence_text",
            "operator": "non_empty"
          },
          {
            "path": "reason",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "codable_and_noncodable_evidence_are_disjoint",
        "when": [
          {
            "path": "diagnoses",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "diagnoses",
            "operator": "disjoint_fields",
            "item_path": "evidence_text",
            "other_path": "non_codable_mentions",
            "other_item_path": "evidence_text"
          }
        ]
      }
    ],
    "evidence_bindings": [
      {
        "id": "diagnosis_evidence_matches_input",
        "for_each": "diagnoses",
        "text_path": "evidence_text",
        "span_path": "char_span"
      },
      {
        "id": "noncodable_evidence_matches_input",
        "for_each": "non_codable_mentions",
        "text_path": "evidence_text",
        "span_path": "char_span"
      }
    ]
  },
  "permissions": {
    "key": "diagnosis-extractor-v1-2",
    "name": "诊断提取智能体默认权限",
    "description": "允许从已脱敏文本执行本地明示诊断提取和固定 ICD-10-CN 目录精确候选；禁止推断、结算和写回。",
    "tools": {},
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_writeback_blocked": true
  },
  "phi_redaction": "required",
  "context_required": true,
  "recorder_required": true,
  "metrics_required": true,
  "requirements": {
    "min_runtime_version": "2.0.0",
    "icoder_runtime_modules": [
      "icoder_runtime.backends.governed_diagnosis_extractor_provider",
      "official_agents.diagnosis_extractor.agent"
    ]
  },
  "llm_capabilities": {
    "required_models": [],
    "supports_tool_calling": false,
    "supports_json_mode": true,
    "supports_mcp_tools": false
  },
  "non_goals": [
    "不替代临床诊断或编码员最终决策",
    "不从用药、检验或手术反推未记录诊断",
    "不自动写回 EMR/HIS/医保系统"
  ],
  "human_review_required_when": [
    "所有本地基线输出",
    "候选编码不可唯一映射或目录不存在",
    "诊断为疑似、待排、否定或既往状态",
    "证据跨度无法在输入原文中验证",
    "目录来源、许可或结算权威尚未取得外部证明"
  ],
  "default_runtime_mode": "governed_local_explicit_diagnosis_baseline",
  "available_runtime_modes": [
    "governed_local_explicit_diagnosis_baseline"
  ],
  "example_inputs": [
    {
      "text": "出院诊断：急性前壁心肌梗死。既往有高血压病史。请提取本次诊断并给出 ICD-10-CN 候选。"
    }
  ],
  "example_outputs": [
    {
      "status": "WARNING",
      "diagnoses": [
        {
          "diagnosis_text": "急性前壁心肌梗死",
          "evidence_text": "急性前壁心肌梗死",
          "char_span": [
            5,
            13
          ],
          "assertion_status": "present",
          "icd10_cn_code": "I21.001",
          "icd10_cn_name": "急性前壁心肌梗死",
          "confidence": "high",
          "verification": "exact_catalog_name_unique; authority=source_unverified; license=external_review_required; clinical_support_not_assessed"
        }
      ],
      "non_codable_mentions": [
        {
          "mention_text": "高血压",
          "evidence_text": "既往有高血压病史",
          "char_span": [
            14,
            22
          ],
          "assertion_status": "history_of",
          "reason": "既往史，非本次确诊诊断，不作为当前编码"
        }
      ],
      "issues_found": [
        "高血压：既往史提及，不作为本次就诊当前诊断编码",
        "本地 ICD-10-CN 目录 authority_status=source_unverified、license_status=external_review_required；目录候选不具有结算权威。"
      ],
      "manual_review_required": true,
      "trace_refs": {
        "run_id": "sample-run",
        "provider_trace_refs": [
          "sample-run:governed-diagnosis-extraction"
        ]
      }
    }
  ],
  "metadata": {
    "created_at": "2026-08-08",
    "author": "iCoDer",
    "corti_match": "diagnosis-extractor-agent",
    "audit_note": "Governed local explicit-diagnosis baseline with exact evidence spans, fixed catalog integrity, no LLM or network dependency, fail-closed unique candidate mapping, and mandatory human review."
  },
  "built_by": "icoder",
  "code": {},
  "integrity": {
    "sha256": "26f03270be8e496259600d3255997b1c48594eca7c543ee52172ad085812a92d"
  }
}
