              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "interpretation": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            }
          },
          "required": [
            "category",
            "documented_result",
            "evidence_ref",
            "interpretation"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "medication_instructions": {
        "type": "string",
        "maxLength": 4096,
        "minLength": 0
      },
      "medication_reconciliation_status": {
        "type": "string",
        "maxLength": 32768,
        "const": "NOT_RECONCILED_GOVERNED_MEDICATION_RECONCILIATION_REQUIRED"
      },
      "follow_up": {
        "type": "string",
        "maxLength": 4096,
        "minLength": 0
      },
      "warning_signs": {
        "type": "string",
        "maxLength": 4096,
        "minLength": 0
      },
      "lifestyle": {
        "type": "string",
        "maxLength": 4096,
        "minLength": 0
      },
      "pending_results": {
        "type": "string",
        "maxLength": 4096,
        "minLength": 0
      },
      "teach_back_questions": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "maxItems": 30,
        "minItems": 0
      },
      "clarification_questions": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "maxItems": 30,
        "minItems": 0
      },
      "contradictions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            },
            "resolution": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "UNRESOLVED_CLINICAL_REVIEW_REQUIRED"
              ]
            },
            "evidence_ref": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          },
          "required": [
            "description",
            "resolution",
            "evidence_ref"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "missing_items": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "maxItems": 5,
        "minItems": 0
      },
      "source_completeness": {
        "type": "object",
        "properties": {
          "documented_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "maxItems": 13,
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence_item_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "input_truncated": {
            "type": "boolean"
          },
          "missing_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "maxItems": 5,
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "documented_sections",
          "evidence_item_count",
          "input_truncated",
          "missing_sections"
        ],
        "additionalProperties": false
      },
      "evidence_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "char_span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2,
              "x-order": "nondecreasing"
            },
            "evidence_id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "evidence_text": {
              "type": "string",
              "maxLength": 4096,
