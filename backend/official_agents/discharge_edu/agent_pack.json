      "diagnosis_summary": {
        "type": "string",
        "maxLength": 4096,
        "minLength": 0
      },
      "encounter_summary": {
        "type": "object",
        "properties": {
          "discharge_destination": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          "reason_for_visit": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 0
          },
          "treatment_course": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 0
          }
