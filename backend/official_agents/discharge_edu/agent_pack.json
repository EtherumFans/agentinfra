    "optional_fields": [],
    "field_types": {
      "education_status": "string",
      "diagnosis_summary": "string",
      "encounter_summary": "object",
      "key_results": "array",
      "medication_instructions": "string",
      "medication_reconciliation_status": "string",
      "follow_up": "string",
      "warning_signs": "string",
      "lifestyle": "string",
