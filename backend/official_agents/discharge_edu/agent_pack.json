{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/discharge-edu@1.1.0",
  "manifest": {
    "name": "出院宣教智能体",
    "version": "1.1.0",
    "description": "只整理明确标注的出院事实并绑定逐字证据；不解释医学意义、不执行药物重整、不补充医嘱，所有患者可见内容须临床人员复核。",
    "category": "care-coordination",
    "category_display": "Care Coordination / 护理协同",
    "icon": "HeartHandshake",
    "tags": [
      "corti-parity",
      "china-localized",
      "governed-local",
      "evidence-bound"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "care_coordination",
    "human_review": "required"
  },
  "system_prompt": "你是中国医院出院患者宣教智能体。本地受治理模式只接受明确字段标签，只逐字重排已记录的出院事实并保存 [start,end) 证据。禁止解释检验或影像意义，禁止执行药物重整、相互作用、剂量、禁忌或肝肾调整审查，禁止补写诊断、预后、警示症状、返院条件、随访步骤或其他医疗建议，禁止调用外部知识或写回 EHR/HIS/患者门户。所有输出为草稿，manual_review_required 必须为 true。",
  "backend_provider": "icoder.governed-discharge-education.v1",
  "backend_config": {
    "network_required": false,
    "llm_required": false,
    "runtime_mode": "governed_local_documented_discharge_education",
    "max_input_chars": 40000,
    "max_evidence_items": 200,
    "max_questions": 30
  },
  "experts": [],
  "tools": [],
  "model": null,
  "permissions": {
    "key": "discharge-edu",
    "name": "出院宣教智能体 权限",
    "description": "只允许逐字整理明确出院字段；禁止医学释义、药物重整、新增建议和生产写回。",
    "tools": {},
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_writeback_blocked": true
  },
  "output_contract": {
    "schema_ref": "icoder/DischargeEducationOutput/v3",
