  "non_goals": [
    "不把逐字记录改写为通俗医学释义，不提供阅读等级或多语言翻译",
    "不解释检验、影像、操作结果的临床意义或预后",
    "不执行药物重整、相互作用、剂量、禁忌、过敏或肝肾功能审查",
    "不补充未记录的警示症状、返院条件、随访、生活方式或其他医疗建议",
    "不调用 PubMed、Web Search、Medical Calculator 或外部网络",
    "不自动写回 EMR/HIS 或患者门户"
  ],
  "human_review_required_when": [
    "all patient-facing discharge content before release",
    "any source field is missing, conflicting, stale, truncated, or not explicitly labelled"
  ],
