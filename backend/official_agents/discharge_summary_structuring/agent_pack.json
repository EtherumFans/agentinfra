{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/discharge-summary-structuring@1.1.0",
  "manifest": {
    "name": "出院小结结构化智能体",
    "version": "1.1.0",
    "description": "将带明确章节标题的中英文出院小结逐字重组为证据绑定结构；不总结未标注叙事、不推断临床事实、不分配编码、不重整药物或写回病历。",
    "category": "care-coordination",
    "category_display": "Care Coordination / 医疗协同",
    "icon": "FileText",
    "tags": [
      "discharge-summary",
      "structuring",
      "evidence-bound",
      "deterministic",
      "cn-adapted",
      "human-review"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "human_review": "required",
    "hidden_from_hub": false,
    "use_case": "care_coordination"
  },
  "backend_provider": "icoder.governed-discharge-summary.v1",
  "backend_config": {
    "network_required": false,
    "llm_required": false,
    "runtime_mode": "governed_local_documented_discharge_summary_structuring",
    "max_input_chars": 40000,
    "max_evidence_items": 200,
    "max_items_per_section": 100
  },
  "system_prompt": "你是 iCoDer Governed Discharge Summary Structuring Agent。\n只结构化明确中英文章节标题下的出院事实，并为每条事实保留脱敏输入中的精确字符证据。\n不得总结未标注自由叙事；不得推断诊断、因果、严重程度、预后或治疗意图；不得分配 ICD 编码。\n不得执行药物重整、相互作用、禁忌、剂量或过敏筛查；不得新增出院医嘱、随访、返院条件或医疗建议。\n未提供受支持章节时返回 INPUT_REQUIRED；资料不完整时返回 PARTIAL 和缺失章节。\n所有输出须临床人员复核，生产写回始终阻断。",
  "experts": [],
  "tools": [],
  "model": null,
  "non_goals": [
    "不总结未标注自由叙事",
    "不推断、补写或改变临床事实",
    "不分配或验证 ICD-10-CN/ICD-9-CM-3 编码",
    "不执行药物重整或药品知识筛查",
    "不新增医嘱、随访、返院条件或医疗建议",
    "不写回 HIS/EMR 或患者门户",
    "不绕过 PHI 脱敏和人工复核"
  ],
  "output_contract": {
    "schema_ref": "icoder/DischargeSummaryStructured/v5",
    "a2a_parts": [
      "DataPart"
    ],
    "required_fields": [
      "structuring_status",
      "encounter_metadata",
      "admission_reason",
      "diagnoses",
      "procedures",
      "treatment_course",
      "key_results",
      "discharge_orders",
      "follow_up_recommendations",
      "discharge_status",
      "allergies",
      "pending_results",
      "complications",
      "conflicts",
      "missing_sections",
      "source_completeness",
      "evidence_items",
      "limitations",
      "summary_generation_status",
      "icd_codes_assigned",
      "medication_reconciliation_performed",
      "clinical_inference_performed",
      "production_writeback_blocked",
      "manual_review_required",
      "trace_refs"
    ],
    "optional_fields": [],
    "field_definitions": {
      "structuring_status": "COMPLETED/PARTIAL/INPUT_REQUIRED",
      "encounter_metadata": "仅保留明确记录的入院/出院日期、科室和出院去向",
      "admission_reason": "逐字记录的入院原因或主诉",
      "diagnoses": "list[{text, role, evidence_ref}]",
      "procedures": "list[{text, evidence_ref}]",
      "treatment_course": "逐字记录的诊疗/住院经过",
      "key_results": "list[{category, documented_result, evidence_ref}]",
      "discharge_orders": "list[{category, documented_instruction, evidence_ref}]",
      "follow_up_recommendations": "list[{documented_instruction, evidence_ref}]",
      "discharge_status": "{documented_text, normalized_status, evidence_ref}",
      "allergies": "逐字过敏史",
      "pending_results": "list[{documented_text, evidence_ref}]",
      "complications": "list[{documented_text, evidence_ref}]",
      "conflicts": "list[{description, resolution, evidence_ref}]",
      "missing_sections": "缺失核心章节",
      "source_completeness": "解析范围、截断和证据计数",
      "evidence_items": "精确 [start,end) 证据",
      "limitations": "明确能力边界",
      "summary_generation_status": "固定 VERBATIM_SECTION_REORGANIZATION_ONLY",
      "icd_codes_assigned": "固定 false",
      "medication_reconciliation_performed": "固定 false",
      "clinical_inference_performed": "固定 false",
      "production_writeback_blocked": "固定 true",
      "manual_review_required": "固定 true",
      "trace_refs": "运行与 Provider 审计引用"
    },
