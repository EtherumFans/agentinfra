          },
          {
            "path": "dip_review.status",
            "operator": "equals",
            "value": "NO_AUTHORIZED_REGIONAL_DIP_PACK"
          }
        ]
      },
      {
        "id": "unassessed_drg_input_never_runs_rules",
        "when": [
          {
            "path": "development_candidate_group.result_status",
            "operator": "equals",
            "value": "NOT_ASSESSED"
