    "field_relations": [
      {
        "id": "ready_drg_review_has_governed_candidate",
        "when": [
          {
            "path": "review_status",
            "operator": "equals",
            "value": "READY_FOR_CODER_REVIEW"
          }
        ],
        "must": [
          {
            "path": "missing_required_fields",
            "operator": "empty"
          },
          {
            "path": "input_conflicts",
            "operator": "empty"
          },
          {
            "path": "local_development_rules_used",
