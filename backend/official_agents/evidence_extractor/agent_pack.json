{
  "format_version": "1.2",
  "agent_type": "expert-stub",
  "agent_ref": "icoder/evidence-extractor@1.0.0",
  "manifest": {
    "name": "Evidence Extractor",
    "version": "1.0.0",
    "description": "Stage 1 of MedCodER 5-stage pipeline. 从病历文本中提取结构化临床事实：诊断事实、手术事实、否定发现、病史条件。输出带证据文本和字符位置的 JSON。LLM 主路径 (DeepSeek json_mode) + 离线 deterministic fallback 兜底。",
    "category": "medical-coding",
    "icon": "FileSearch",
    "tags": ["medcoder", "stage-1", "extraction", "rag-prerequisite"]
  },
  "system_prompt": "你是一个病历证据提取专家。你的任务是：\n1. 从病历中提取所有可编码的诊断事实（含部位、病因、形态）\n2. 提取所有手术/操作事实\n3. 标记否定发现（'否认'、'排除'、'无'等）\n4. 标记既往病史（'X年前'、'既往有'等）\n5. 每个事实必须附带原文引用（evidence_text）和字符位置（char_start, char_end）\n\n输出 JSON:\n{\n  \"diagnosis_facts\": [{\"fact\": \"...\", \"evidence_text\": \"...\", \"char_start\": 0, \"char_end\": 50, \"doc_type\": \"入院记录\"}],\n  \"procedure_facts\": [{\"fact\": \"...\", \"evidence_text\": \"...\", \"char_start\": 0, \"char_end\": 50}],\n  \"negated_findings\": [{\"fact\": \"...\", \"reason\": \"否认\"}],\n  \"historical_conditions\": [{\"fact\": \"...\", \"years_ago\": 5}]\n}",
  "experts": [
    {
      "expert_id": "evidence-extractor",
      "name": "Evidence Extractor",
      "role": "primary",
      "description": "MedCodER Stage 1 — extract diagnosis / procedure / negated / historical facts. LLM gateway (DeepSeek V4) with deterministic offline fallback."
    }
  ],
  "tools": [
    {"name": "guard_input", "type": "guard", "stage": "pre-extraction", "ref": "app.icoder.guards.input_guard:guard_input"},
    {"name": "guard_output", "type": "guard", "stage": "post-extraction", "ref": "app.icoder.guards.output_guard:guard_output"}
  ],
  "model": {
    "primary": "deepseek-v4",
    "fallback": "deepseek-v4-flash",
    "temperature": 0.0,
    "max_tokens": 2048,
    "json_mode": true
  },
  "pipeline": {
    "name": "stage1-extraction",
    "stages": [
      {"name": "input_guard", "engine": "guard", "purpose": "PHI redaction + length cap"},
      {"name": "llm_extract", "engine": "llm", "model": "deepseek-v4", "output": "json", "fallback": "offline_deterministic"},
      {"name": "output_guard", "engine": "guard", "purpose": "schema validation + char_span sanity check"}
    ],
    "upstream_stage": "none (entry point of MedCodER)",
    "downstream_stage": "stage2-retrieval (index_navigator)"
  },
  "non_goals": [
    "不分配 ICD 编码 — 仅提取结构化事实，编码分配由 index_navigator (Stage 2) + code_reconciler (Stage 4) 完成",
    "不评估最终编码质量 — F1 指标在 e2e_medcoder_validation.py 内部",
    "不写回 EMR / HIS / 医保结算",
    "不绕过 PHI redaction",
    "不输出未脱敏 PHI"
  ],
  "output_contract": {
    "schema_ref": "icoder/EvidenceFacts/v1",
    "a2a_parts": ["DataPart"],
    "required_fields": [
      "diagnosis_facts",
      "procedure_facts",
      "negated_findings",
      "historical_conditions"
    ],
    "field_shapes": {
      "diagnosis_facts[].fact": "str",
      "diagnosis_facts[].evidence_text": "str",
      "diagnosis_facts[].char_start": "int",
      "diagnosis_facts[].char_end": "int",
      "diagnosis_facts[].doc_type": "str (default 'present_illness')",
      "procedure_facts[].evidence_text": "str",
      "negated_findings[].reason": "str (one of 否认/无/未见/排除/未发现)",
      "historical_conditions[].years_ago": "int | null"
    }
  },
  "permissions": {
    "key": "evidence-extraction",
    "name": "证据提取权限",
    "description": "只读提取，无编码分配",
    "tools": {
      "guard_input": "allowed",
      "guard_output": "allowed",
      "writeback": "blocked"
    },
    "production_writeback_blocked": true
  },
  "phi_redaction": "required",
  "context_required": true,
  "recorder_required": true,
  "metrics_required": true,
  "requirements": {
    "min_runtime_version": "2.0.0",
    "icoder_runtime_modules": [
      "icoder_runtime.core.llm_gateway"
    ]
  },
  "llm_capabilities": {
    "required_models": [
      {"name": "deepseek-v4", "purpose": "stage1_extraction (with json_mode)"}
    ],
    "supports_tool_calling": false,
    "supports_json_mode": true,
    "supports_mcp_tools": false
  },
  "a2a": {
    "protocol_version": "0.3",
    "endpoint": "/api/icoder/agents/evidence-extractor/v1/message:send",
    "discovery": "/api/icoder/agents",
    "agent_card_ref": "icoder/evidence-extractor@1.0.0"
  },
  "code": {},
  "integrity": {
    "sha256": "PLACEHOLDER_RECOMPUTED_AT_PUBLISH"
  }
}
