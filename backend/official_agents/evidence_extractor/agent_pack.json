      "located_mentions": [
        {
          "input_index": 0,
          "code": "N18.803",
          "evidence_text": "慢性肾脏病3期",
          "char_span": [
            31,
            38
          ],
          "matched_term": "慢性肾脏病3期",
          "match_type": "exact_catalog_term",
          "context_status": "current_mention",
          "context_rule": "no_explicit_context_modifier_detected",
          "clinical_support_assessed": false
        },
        {
          "input_index": 1,
          "code": "E11.900",
          "evidence_text": "2型糖尿病",
          "char_span": [
            41,
