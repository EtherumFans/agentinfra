{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/evidence-extractor@1.1.0",
  "manifest": {
    "name": "证据提及定位智能体",
    "version": "1.1.0",
    "description": "基于固定 SHA-256 的本地 ICD-10-CN 目录，为输入候选编码定位代码字面量或目录术语的精确原文 span。仅描述文档可追溯性，不判断临床支持、诊断成立或编码有效性。",
    "category": "medical-coding",
    "category_display": "Coding and Revenue Cycle / 编码与收入周期",
    "icon": "FileSearch",
    "tags": [
      "icd-10-cn",
      "exact-mention",
      "span-grounding",
      "governed-assets",
      "deterministic"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "human_review": "required",
    "hidden_from_hub": false,
    "use_case": "coding_revenue_cycle"
  },
  "backend_provider": "icoder.governed-evidence-extractor.v1",
  "backend_config": {
    "exact_mention_extraction": {
      "asset_id": "cn.icd10cn.catalog",
      "version": "observed-local-2026-05-19",
      "integrity_required": true,
      "network_required": false,
      "maximum_input_codes": 20,
      "maximum_mentions_per_code": 5,
      "clinical_support_assessed": false,
      "billing_authoritative": false
    }
  },
  "system_prompt": "你是 iCoDer 证据提及定位智能体。只对显式提交的最多 20 个候选编码执行本地精确提及定位：匹配原文中的完整代码字面量，或固定 SHA-256 的 ICD-10-CN 目录中该编码的精确中文名称/同义词；候选编码声明区本身必须屏蔽，不得作为证据。所有 evidence_text 必须与 char_span 指向的原文逐字一致。只在同一句明确出现否定、既往、家族史或疑似标记时记录 context_status；current_mention 仅表示未检测到这些显式标记，绝不代表诊断成立。不得进行同义医学推理、缩写扩展、隐含证据判断、临床支持评分、编码有效性判断或新编码生成。目录来源和许可尚待外部复核，所有结果必须人工审核。",
  "experts": [],
  "tools": [],
  "model": null,
  "non_goals": [
    "不判断临床支持、诊断概率、因果关系或编码有效性",
    "不分配、推荐、纠错、替换或补全编码",
    "不从病历扫描或生成新编码，uncoded_findings 固定为空",
    "不执行同义医学推理、缩写扩展或间接证据推断",
    "不写回 EMR / HIS，不绕过 PHI redaction"
  ],
  "output_contract": {
    "schema_ref": "icoder/CodedEvidence/v11",
    "a2a_parts": [
      "DataPart"
    ],
    "required_fields": [
      "extraction_status",
      "input_codes",
      "input_code_count",
      "match_basis",
      "located_mentions",
      "code_results",
      "unmatched_codes",
      "uncoded_findings",
      "source_version",
      "limitations",
      "manual_review_required",
      "summary",
      "markdown"
    ],
    "field_definitions": {
      "located_mentions": "list[{input_index, code, evidence_text, char_span, matched_term, match_type, context_status, context_rule, clinical_support_assessed=false}]",
      "code_results": "list[{input_index, code, catalog_status, catalog_display, assignable_catalog_entry, mention_count, result_status, clinical_support_assessed=false, manual_review_prompt}]",
      "uncoded_findings": "固定空数组；此 Agent 不扫描或生成新编码"
    },
    "field_types": {
      "extraction_status": "string",
      "input_codes": "array",
      "input_code_count": "integer",
      "match_basis": "string",
      "located_mentions": "array",
      "code_results": "array",
      "unmatched_codes": "array",
      "uncoded_findings": "array",
      "source_version": "string",
      "limitations": "array",
      "manual_review_required": "boolean",
      "summary": "string",
      "markdown": "string"
    },
    "field_schemas": {
      "extraction_status": {
        "type": "string",
        "maxLength": 32768,
        "enum": [
          "COMPLETED",
          "INPUT_REQUIRED",
          "CATALOG_UNAVAILABLE"
        ]
      },
      "input_codes": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "maxItems": 20,
        "minItems": 0
      },
      "input_code_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20
      },
      "match_basis": {
        "type": "string",
        "maxLength": 32768,
        "const": "EXACT_CATALOG_TERM_OR_CODE_LITERAL_ONLY"
      },
      "located_mentions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "char_span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2,
              "x-order": "nondecreasing"
            },
            "clinical_support_assessed": {
              "type": "boolean",
              "const": false
            },
            "code": {
              "type": "string",
              "maxLength": 32,
              "minLength": 1
            },
            "context_rule": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "context_status": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "current_mention",
                "negated",
                "historical",
                "family_history",
                "suspected"
              ]
            },
            "evidence_text": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "input_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19
            },
            "match_type": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "exact_code_literal",
                "exact_catalog_term"
              ]
            },
            "matched_term": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            }
          },
          "required": [
            "char_span",
            "clinical_support_assessed",
            "code",
            "context_rule",
            "context_status",
            "evidence_text",
            "input_index",
            "match_type",
            "matched_term"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "code_results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assignable_catalog_entry": {
              "type": "boolean"
            },
            "catalog_display": {
              "type": "string",
              "maxLength": 512,
              "minLength": 0
            },
            "catalog_status": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "found",
                "not_found",
                "unavailable"
              ]
            },
            "clinical_support_assessed": {
              "type": "boolean",
              "const": false
            },
            "code": {
              "type": "string",
              "maxLength": 32,
              "minLength": 1
            },
            "input_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19
            },
            "manual_review_prompt": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            },
            "mention_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "result_status": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "EXACT_MENTION_FOUND",
                "NO_EXACT_MENTION",
                "CODE_NOT_IN_CATALOG",
                "CATALOG_UNAVAILABLE"
              ]
            }
          },
          "required": [
            "assignable_catalog_entry",
            "catalog_display",
            "catalog_status",
            "clinical_support_assessed",
            "code",
            "input_index",
            "manual_review_prompt",
            "mention_count",
            "result_status"
          ],
          "additionalProperties": false
        },
        "maxItems": 20,
        "minItems": 0
      },
      "unmatched_codes": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "maxItems": 20,
        "minItems": 0
      },
      "uncoded_findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "finding": {
              "type": "string",
              "maxLength": 32768
            },
            "evidence_text": {
              "type": "string",
              "maxLength": 32768
            },
            "char_span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2,
              "x-order": "nondecreasing"
            },
            "reason": {
              "type": "string",
              "maxLength": 32768
            }
          },
          "required": [
            "finding",
            "reason"
          ],
          "additionalProperties": false
        },
        "maxItems": 0,
        "minItems": 0
      },
      "source_version": {
        "type": "string",
        "maxLength": 512,
        "minLength": 0
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        },
        "maxItems": 10,
        "minItems": 1
      },
      "manual_review_required": {
        "type": "boolean",
        "const": true
      },
      "summary": {
        "type": "string",
        "maxLength": 512,
        "minLength": 1
      },
      "markdown": {
        "type": "string",
        "maxLength": 20000,
        "minLength": 1
      }
    },
    "field_relations": [
      {
        "id": "input_required_has_no_extraction_results",
        "when": [
          {
            "path": "extraction_status",
            "operator": "equals",
            "value": "INPUT_REQUIRED"
          }
        ],
        "must": [
          {
            "path": "input_codes",
            "operator": "empty"
          },
          {
            "path": "located_mentions",
            "operator": "empty"
          },
          {
            "path": "code_results",
            "operator": "empty"
          }
        ]
      },
      {
        "id": "completed_extraction_has_input_codes",
        "when": [
          {
            "path": "extraction_status",
            "operator": "equals",
            "value": "COMPLETED"
          }
        ],
        "must": [
          {
            "path": "input_codes",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "exact_mentions_are_traceable_not_clinical_support",
        "for_each": "located_mentions",
        "when": [
          {
            "path": "evidence_text",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "code",
            "operator": "non_empty"
          },
          {
            "path": "evidence_text",
            "operator": "non_empty"
          },
          {
            "path": "clinical_support_assessed",
            "operator": "equals",
            "value": false
          }
        ]
      },
      {
        "id": "exact_mention_policy_requires_manual_review",
        "when": [
          {
            "path": "match_basis",
            "operator": "equals",
            "value": "EXACT_CATALOG_TERM_OR_CODE_LITERAL_ONLY"
          }
        ],
        "must": [
          {
            "path": "manual_review_required",
            "operator": "equals",
            "value": true
          }
        ]
      }
    ],
    "evidence_bindings": [
      {
        "id": "located_mention_matches_input",
        "for_each": "located_mentions",
        "text_path": "evidence_text",
        "span_path": "char_span"
      }
    ],
    "cross_agent_relations": [
      {
        "id": "input_codes_match_extracted_diagnoses",
        "local_path": "code_results",
        "local_item_path": "code",
        "upstream_agent_id": "diagnosis-extractor",
        "upstream_path": "diagnoses",
        "upstream_item_path": "icd10_cn_code",
        "operator": "local_items_subset_upstream_items",
        "normalization": "medical_code",
        "required": false
      }
    ]
  },
  "permissions": {
    "key": "evidence-extraction",
    "name": "证据提及定位权限",
    "description": "只读精确提及定位，无临床或编码决策权限",
    "tools": {},
    "production_writeback_blocked": true,
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true
  },
  "phi_redaction": "required",
  "context_required": false,
  "recorder_required": true,
  "metrics_required": true,
  "requirements": {
    "min_runtime_version": "2.0.0",
    "local_assets": [
      "cn.icd10cn.catalog"
    ]
  },
  "llm_capabilities": {
    "required_models": [],
    "supports_tool_calling": false,
    "supports_json_mode": false,
    "supports_mcp_tools": false
  },
  "a2a": {
    "protocol_version": "0.3",
    "endpoint": "/api/icoder/agents/evidence-extractor/v1/message:send",
    "discovery": "/api/icoder/agents",
    "agent_card_ref": "icoder/evidence-extractor@1.1.0"
  },
  "default_runtime_mode": "governed_local_exact_mention_extraction",
  "available_runtime_modes": [
    "governed_local_exact_mention_extraction"
  ],
  "example_inputs": [
