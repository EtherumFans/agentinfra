{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/icd10-navigator@1.1.0",
  "manifest": {
    "name": "ICD-10 索引导航智能体",
    "version": "1.1.0",
    "description": "基于固定 SHA-256 的本地 ICD-10-CN 目录与术语反向索引执行 Search 和一层 Explore，为编码员提供未验证候选；不分配、不验证、不推荐编码，目录来源与许可待外部复核。",
    "category": "medical-coding",
    "category_display": "Coding and Revenue Cycle / 编码与收入周期",
    "icon": "Compass",
    "tags": [
      "corti-parity",
      "icd-10-cn",
      "local-catalog",
      "governed-assets",
      "deterministic-navigation"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "coding_revenue_cycle",
    "human_review": "required"
  },
  "system_prompt": "你是 iCoDer ICD-10-CN 索引导航智能体。默认运行时只使用经 manifest 固定大小和 SHA-256 的本地目录与术语反向索引：接收一个明确术语或编码，执行一次 Search；首次未命中时最多按输入中明确连接词拆分一次；对最多三个候选执行一层父类目、同层和子条目 Explore。只呈现目录返回内容，不解释病历、不判断临床适用性、不执行 Verify/Guidelines、不分配或推荐编码、不生成目录没有的包括/不包括说明。所有候选均为未验证索引条目，manual_review_required 始终为 true，必须进入 Code Validation 并由编码员审核。目录 authority_status=source_unverified、license_status=external_review_required、billing_authoritative=false，仅限开发验证。",
  "backend_provider": "icoder.governed-icd-navigator.v1",
  "backend_config": {
    "catalog_navigation": {
      "asset_id": "cn.icd10cn.catalog",
      "version": "observed-local-2026-05-19",
      "integrity_required": true,
      "network_required": false,
      "maximum_candidate_blocks": 3,
      "maximum_rephrasing_attempts": 1,
      "traversal_depth_up": 1,
      "traversal_depth_down": 1,
      "instructional_notes_available": false,
      "billing_authoritative": false
    }
  },
  "experts": [],
  "tools": [],
