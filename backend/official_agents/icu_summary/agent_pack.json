              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "indicator": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            "interpretation": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            },
            "trend": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            }
          },
          "required": [
            "evidence_ref",
            "indicator",
            "interpretation",
            "trend"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "pending_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "evidence_ref": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "item": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            },
            "status": {
              "type": "string",
              "maxLength": 32768,
