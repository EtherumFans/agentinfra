{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/icu-summary@1.1.0",
  "manifest": {
    "name": "ICU 入院摘要智能体",
    "version": "1.1.0",
    "description": "只整理明确标注的 ICU 入院事实并绑定逐字证据；不计算临床评分、不应用异常阈值、不筛查药物、不生成治疗建议，所有输出须 ICU 医师复核。",
    "category": "point-of-care",
    "category_display": "Point of Care Tools / 床旁工具",
    "icon": "Activity",
    "tags": [
      "corti-parity",
      "china-icu",
      "governed-local",
      "evidence-bound"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "point_of_care",
    "human_review": "required"
  },
  "system_prompt": "你是中国医院 ICU 入院摘要智能体。本地受治理模式只接受明确字段标签，只重排逐字记录并保存 [start,end) 证据。禁止计算 APACHE II、SOFA、GCS 或死亡风险；禁止按常识或阈值判断生命体征/检验异常；禁止执行药物相互作用、剂量、肝肾调整或适应证审查；禁止补写诊断、病情轨迹、风险、治疗建议、医嘱、任务负责人或缺失状态；禁止写回 EHR/HIS。所有输出为草稿，manual_review_required 必须为 true。",
  "backend_provider": "icoder.governed-icu-summary.v1",
  "backend_config": {
    "network_required": false,
    "llm_required": false,
    "runtime_mode": "governed_local_documented_icu_admission_summary",
    "max_input_chars": 40000,
    "max_evidence_items": 200
  },
  "experts": [],
  "tools": [],
  "model": null,
  "permissions": {
    "key": "icu-summary",
    "name": "ICU 入院摘要智能体 权限",
    "description": "只允许整理明确 ICU 入院字段；禁止评分、药物筛查、治疗建议和生产写回。",
    "tools": {},
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_writeback_blocked": true
  },
  "output_contract": {
    "schema_ref": "icoder/IcuSummaryOutput/v3",
    "required_fields": [
      "summary_status",
      "patient_background",
      "admission_reason",
      "admission_diagnoses",
      "timeline",
      "active_problems",
      "organ_support",
      "medications",
      "vital_signs",
      "laboratory_results",
      "procedures",
      "key_trends",
      "pending_items",
      "risks",
      "conflicts",
      "source_completeness",
      "evidence_items",
      "limitations",
      "clinical_scores_status",
      "medication_screening_status",
      "clinical_recommendations_generated",
      "production_writeback_blocked",
      "manual_review_required",
      "trace_refs"
    ],
    "optional_fields": [],
    "field_types": {
      "summary_status": "string",
      "patient_background": "object",
      "admission_reason": "string",
      "admission_diagnoses": "array",
      "timeline": "array",
      "active_problems": "array",
      "organ_support": "array",
      "medications": "array",
      "vital_signs": "array",
      "laboratory_results": "array",
      "procedures": "array",
      "key_trends": "array",
      "pending_items": "array",
      "risks": "array",
      "conflicts": "array",
