            },
            "evidence_ref": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "risk": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            }
          },
          "required": [
            "basis",
            "evidence_ref",
            "risk"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "conflicts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            },
            "evidence_ref": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "field": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          },
          "required": [
            "description",
            "evidence",
            "evidence_ref",
            "field"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "source_completeness": {
        "type": "object",
        "properties": {
          "evidence_item_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "input_truncated": {
            "type": "boolean"
          },
          "missing_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "maxItems": 11,
            "minItems": 0
          }
        },
        "required": [
          "evidence_item_count",
          "input_truncated",
          "missing_sections"
        ],
        "additionalProperties": false
      },
      "evidence_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "char_span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2,
              "x-order": "nondecreasing"
            },
            "evidence_id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "evidence_text": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "field": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "patient_information",
                "admission_reason",
                "admission_diagnoses",
                "medical_history",
                "surgical_history",
                "allergies",
                "social_history",
                "timeline",
                "active_problems",
                "organ_support",
                "medications",
                "vital_signs",
                "laboratory_results",
                "procedures",
                "key_trends",
                "pending_items",
                "risks",
                "conflicts"
              ]
            },
            "source_label": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          },
          "required": [
            "char_span",
            "evidence_id",
            "evidence_text",
            "field",
            "source_label"
          ],
          "additionalProperties": false
        },
        "maxItems": 200,
        "minItems": 0
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 1
        },
        "maxItems": 5,
        "minItems": 5
      },
      "clinical_scores_status": {
        "type": "string",
        "maxLength": 32768,
        "const": "NOT_CALCULATED_GOVERNED_CALCULATOR_REQUIRED"
      },
      "medication_screening_status": {
        "type": "string",
        "maxLength": 32768,
        "const": "NOT_SCREENED_LICENSED_DRUG_SOURCE_REQUIRED"
      },
      "clinical_recommendations_generated": {
        "type": "boolean",
        "const": false
      },
      "production_writeback_blocked": {
        "type": "boolean",
        "const": true
      },
      "manual_review_required": {
        "type": "boolean",
        "const": true
      },
      "trace_refs": {
        "type": "object",
        "properties": {
          "provider_trace_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            },
            "maxItems": 10,
            "minItems": 0
          },
          "run_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      }
    },
    "field_relations": [
      {
        "id": "input_required_has_no_icu_fact_claims",
        "when": [
          {
            "path": "summary_status",
            "operator": "equals",
            "value": "INPUT_REQUIRED"
          }
        ],
        "must": [
          {
            "path": "admission_diagnoses",
            "operator": "empty"
          },
          {
            "path": "active_problems",
            "operator": "empty"
          },
          {
            "path": "organ_support",
            "operator": "empty"
          },
          {
            "path": "evidence_items",
            "operator": "empty"
          },
          {
            "path": "manual_review_required",
            "operator": "equals",
            "value": true
          }
        ]
      },
      {
        "id": "completed_icu_summary_has_evidence",
        "when": [
          {
            "path": "summary_status",
            "operator": "equals",
            "value": "COMPLETED"
          }
        ],
        "must": [
          {
            "path": "admission_reason",
            "operator": "non_empty"
          },
          {
            "path": "admission_diagnoses",
            "operator": "non_empty"
          },
          {
            "path": "evidence_items",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "partial_icu_summary_has_evidence",
        "when": [
          {
            "path": "summary_status",
            "operator": "equals",
            "value": "PARTIAL"
          }
        ],
        "must": [
          {
            "path": "evidence_items",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "local_icu_summary_never_claims_expert_outputs",
        "when": [
          {
            "path": "clinical_scores_status",
            "operator": "equals",
            "value": "NOT_CALCULATED_GOVERNED_CALCULATOR_REQUIRED"
          }
        ],
        "must": [
          {
            "path": "medication_screening_status",
            "operator": "equals",
            "value": "NOT_SCREENED_LICENSED_DRUG_SOURCE_REQUIRED"
          },
          {
            "path": "clinical_recommendations_generated",
            "operator": "equals",
            "value": false
          },
          {
            "path": "production_writeback_blocked",
            "operator": "equals",
            "value": true
          },
          {
            "path": "manual_review_required",
            "operator": "equals",
            "value": true
          }
        ]
      },
      {
        "id": "icu_diagnosis_is_traceable",
        "for_each": "admission_diagnoses",
        "when": [
          {
            "path": "diagnosis",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "diagnosis",
            "operator": "non_empty"
          },
          {
            "path": "evidence_ref",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "icu_organ_support_is_traceable",
        "for_each": "organ_support",
        "when": [
          {
            "path": "detail",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "detail",
            "operator": "non_empty"
          },
          {
            "path": "evidence_ref",
            "operator": "non_empty"
          }
        ]
      }
    ],
    "evidence_bindings": [
      {
        "id": "icu_summary_evidence_matches_input",
        "for_each": "evidence_items",
        "text_path": "evidence_text",
        "span_path": "char_span"
      }
    ]
  },
  "phi_redaction": "required",
  "context_required": true,
  "recorder_required": true,
  "metrics_required": true,
  "requirements": {
    "min_runtime_version": "1.0.0",
    "icoder_runtime_modules": []
  },
  "non_goals": [
    "不计算 APACHE II、SOFA、GCS、死亡风险或其他临床评分",
    "不应用生命体征或检验阈值，不标记临床异常或危急值",
    "不执行药物相互作用、剂量、适应证或肝肾调整审查",
    "不调用 PubMed、DrugBank、Medical Calculator 或外部网络",
    "不生成治疗建议、医嘱、诊断因果或临床优先级",
    "不自动写回 EMR/HIS"
  ],
  "human_review_required_when": [
    "all ICU summaries before clinical use",
    "any source field is missing, conflicting, stale, truncated, or not explicitly labelled"
  ],
  "example_inputs": [
    {
      "title": "中国医院 AICU 明确字段入院摘要",
      "input_text": "患者信息：患者编号已脱敏，AICU\n入ICU原因：术后循环监护\n入院诊断：主动脉夹层术后\n病史：高血压病史已记录\n手术史：2026-08-24主动脉置换术\n过敏史：原记录注明无已知药物过敏\n社会史：未记录吸烟饮酒情况\n活动问题：术后循环监护\n用药：去甲肾上腺素0.05μg/kg/min，给药途径未记录\n生命体征：血压110/68mmHg，心率88次/分\n检验结果：乳酸由4.2降至2.1mmol/L\n操作/手术：2026-08-24主动脉置换术\n器官支持：有创机械通气FiO2 40%\n时间线：08:30术后转入AICU\n趋势：乳酸由4.2降至2.1mmol/L\n待办：血气分析待回报\n风险：原记录标注出血风险\n矛盾/缺口：药物给药途径未记录",
      "extra": {
        "input_profile": "explicit_labelled_icu_admission",
        "region": "cn"
      }
    }
  ],
  "metadata": {
    "created_at": "2026-07-11",
    "updated_at": "2026-08-24",
    "author": "iCoDer",
    "corti_match": "icu-admission-summary-agent",
    "audit_note": "Governed local documented-fact baseline. It does not claim Corti PubMed, Medical Calculator, DrugBank, clinical scoring, threshold interpretation or EHR integration parity."
  },
  "built_by": "icoder",
  "example_outputs": [
