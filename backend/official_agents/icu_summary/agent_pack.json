            "evidence_ref": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "text": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            }
          },
          "required": [
            "evidence_ref",
            "text"
          ],
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "laboratory_results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "evidence_ref": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "text": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            }
          },
          "required": [
