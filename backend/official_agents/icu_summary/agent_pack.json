          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "medications": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "documented_text": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            },
            "dose": {
              "type": "string",
              "maxLength": 256,
              "minLength": 0
            },
            "evidence_ref": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "route": {
              "type": "string",
              "maxLength": 256,
              "minLength": 0
            }
          },
          "required": [
            "documented_text",
