{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/med-reconciliation@1.1.0",
  "manifest": {
    "name": "用药重整智能体",
    "version": "1.1.0",
    "description": "从明确标注的入院前、住院 MAR/用药和出院用药来源提取逐字药物事实，按药名字面值及已记录剂量、途径、频次保守比较转衔差异；不使用模型记忆判断相互作用、禁忌或剂量适宜性。",
    "category": "point-of-care",
    "category_display": "Point of Care Tools / 床旁工具",
    "icon": "Pill",
    "tags": [
      "corti-parity",
      "medication-reconciliation",
      "transition-of-care",
      "evidence-first",
      "deterministic"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "point_of_care",
    "human_review": "required"
  },
  "system_prompt": "你是 iCoDer 受治理本地用药重整智能体。只处理明确标注为入院前/家庭用药、住院中/MAR、拟出院/出院医嘱的来源。每个药物条目必须保留逐字 evidence_text 和 [start,end) char_span；只抽取原文明确记录的药名、剂量、途径、频次、状态和原因，缺失字段保留为空，不得默认口服、按需或补写适应证。只按药名字面值对齐来源，比较已同时记录的剂量/途径/频次，并以来源清单比较产生 CONTINUE/START/STOP/CHANGE/NEEDS_CLARIFICATION；这些分类不是处方或停药建议。无授权 DrugBank/医院药品库时，品牌-通用名、同类重复、相互作用、禁忌、肾/肝功能剂量适宜性一律不得判断，interaction_screening_status 固定为 NOT_ASSESSED_LICENSED_SOURCE_REQUIRED。不得自行开药、停药、调整剂量或生成临床恢复条件；所有结果必须由医师或药师复核。",
  "backend_provider": "icoder.governed-medication-reconciliation.v1",
  "backend_config": {
    "documented_medication_reconciliation": {
      "network_required": false,
      "llm_required": false,
      "maximum_input_characters": 20000,
      "maximum_medications_per_source": 100,
      "name_alignment": "exact_literal_only",
      "documented_fields": [
        "drug_name",
        "dose",
        "route",
        "frequency",
        "status",
        "reason"
      ],
      "interaction_screening_available": false,
      "brand_generic_normalization_available": false,
      "clinical_dose_suitability_assessed": false,
      "production_writeback_blocked": true
    }
  },
  "experts": [],
  "tools": [],
  "model": null,
  "permissions": {
    "key": "med-reconciliation-v1-1",
    "name": "用药重整智能体默认权限",
    "description": "允许本地只读抽取和逐来源字面比较；禁止开药、停药、剂量调整、外部药物知识推断和写回。",
    "tools": {},
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_writeback_blocked": true
  },
  "output_contract": {
    "schema_ref": "icoder/MedicationReconciliationOutput/v4",
    "a2a_parts": [
      "DataPart"
    ],
    "required_fields": [
      "reconciliation_status",
