      "follow_up_items",
      "unresolved_mentions",
      "source_completeness",
      "limitations",
      "manual_review_required",
      "trace_refs"
    ],
    "field_definitions": {
      "reconciliation_status": "COMPLETED | PARTIAL | INPUT_REQUIRED",
      "home_medications": "入院前/家庭用药来源中的逐字药物条目",
      "inpatient_medications": "住院中/MAR 来源中的逐字药物条目",
      "discharge_medications": "拟出院/出院医嘱来源中的逐字药物条目",
      "reconciliation_summary": "按精确药名字面对齐后的来源比较；分类不是处方建议",
      "discrepancies": "从来源清单、明确字段差异和缺失字段直接得到的可追溯问题",
      "interaction_screening_status": "固定为未评估，直到取得授权 DrugBank/医院药品库",
      "interaction_risks": "本地基线固定为空，不从模型记忆生成相互作用",
      "allergy_review_status": "无过敏来源或仅执行完全相同药名字面匹配",
      "allergy_conflicts": "仅完全相同药名字面值与活动/出院药物的冲突",
      "missing_rationale": "明确变化、暂停后重列或清单去向缺少原因",
      "follow_up_items": "供医师或药师确认的中性问题，不包含治疗建议",
      "unresolved_mentions": "来源中缺少明确药名而无法归属的原文",
      "source_completeness": "三类来源是否存在以及是否具备至少双来源比较条件",
      "limitations": "品牌/通用名、药物知识、相互作用、禁忌和剂量适宜性边界",
      "manual_review_required": "固定为 true",
      "trace_refs": "本地 Provider 执行引用"
    },
