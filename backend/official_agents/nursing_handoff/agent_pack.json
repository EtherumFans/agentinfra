          "max_patients",
          "missing_sections",
          "patient_count"
        ],
        "additionalProperties": false
      },
      "evidence_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "char_span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2,
