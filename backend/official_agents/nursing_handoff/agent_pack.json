      "handoff_status": "string",
      "assignment_summary": "array",
      "patient_handoffs": "array",
      "situation": "string",
      "background": "string",
      "assessment": "string",
      "recommendations": "string",
      "safety_risks": "array",
      "lines_devices": "array",
      "pending_tasks": "array",
