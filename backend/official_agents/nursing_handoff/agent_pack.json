            "current_status",
            "documented_escalation_triggers",
            "evidence_refs",
            "gaps_conflicts",
            "key_considerations",
            "labs_diagnostics",
            "lines_devices",
            "medications",
            "missing_sections",
            "patient_identifier",
            "pending_tasks",
            "primary_issue",
            "recent_events",
            "room_bed",
            "safety_precautions"
          ],
          "additionalProperties": false
        },
        "maxItems": 10,
        "minItems": 0
      },
      "situation": {
        "type": "string",
        "maxLength": 32768
      },
      "background": {
        "type": "string",
        "maxLength": 32768
      },
      "assessment": {
        "type": "string",
        "maxLength": 32768
      },
      "recommendations": {
        "type": "string",
        "maxLength": 32768
      },
      "safety_risks": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 32768
        },
        "maxItems": 100,
        "minItems": 0
      },
      "lines_devices": {
