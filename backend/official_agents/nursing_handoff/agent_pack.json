{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/nursing-handoff@1.1.0",
  "manifest": {
    "name": "护理交班智能体",
    "version": "1.1.0",
    "description": "从明确标注的护理交班字段中生成可追溯的多患者 SBAR 视图，突出原文已记录的待办与安全事项。",
    "category": "care-coordination",
    "category_display": "Care Coordination / 护理协同",
    "icon": "Users",
    "tags": [
      "corti-parity",
      "china-nursing",
      "evidence-bound",
      "deterministic-local"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "care_coordination",
    "human_review": "required"
  },
  "system_prompt": "你是中国医院护理交班智能体的受治理本地基线。只整理明确患者分区和明确字段标签中的原文事实，最多处理10名患者。不得推断病情轻重、护理优先级、诊断、生命体征阈值、管路通畅/敷料状态、给药状态、护理措施、医嘱或升级条件；未明确记录时必须保持未记录，不得补写。每条抽取事实必须保留原文和[start,end)字符区间。clinical_priority_assessed 与 medical_calculator_used 必须为 false，production_writeback_blocked 与 manual_review_required 必须为 true。",
  "backend_provider": "icoder.governed-nursing-handoff.v1",
  "backend_config": {
    "documented_nursing_handoff": {
      "network_required": false,
      "llm_required": false,
      "maximum_input_characters": 30000,
      "maximum_patients": 10,
      "input_mode": "explicit_patient_sections_and_field_labels",
      "clinical_priority_assessed": false,
      "medical_calculator_used": false,
      "production_writeback_blocked": true
    }
  },
  "experts": [],
  "tools": [],
  "model": null,
  "permissions": {
    "key": "nursing-handoff",
    "name": "护理交班智能体 权限",
    "description": "只读整理明确标注的护理交班事实；禁止自动写回。",
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_writeback_blocked": true
  },
  "output_contract": {
    "schema_ref": "icoder/NursingHandoffOutput/v4",
    "required_fields": [
      "handoff_status",
      "assignment_summary",
      "patient_handoffs",
      "situation",
      "background",
      "assessment",
      "recommendations",
      "safety_risks",
      "lines_devices",
      "pending_tasks",
      "escalation_triggers",
      "source_completeness",
      "evidence_items",
      "limitations",
      "clinical_priority_assessed",
      "medical_calculator_used",
      "production_writeback_blocked",
      "manual_review_required",
      "trace_refs"
