            },
            "patient_identifier": {
              "type": "string",
              "maxLength": 160,
              "minLength": 1
            },
            "pending_tasks": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1
              },
              "maxItems": 100,
              "minItems": 0
            },
            "primary_issue": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 0
            },
            "recent_events": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1
              },
              "maxItems": 100,
              "minItems": 0
            },
            "room_bed": {
              "type": "string",
              "maxLength": 160,
              "minLength": 0
            },
            "safety_precautions": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1
              },
              "maxItems": 100,
              "minItems": 0
            }
          },
          "required": [
