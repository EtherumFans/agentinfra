          "maxLength": 32768
        },
        "maxItems": 200,
        "minItems": 0
      },
      "escalation_triggers": {
        "type": "string",
        "maxLength": 32768
      },
      "source_completeness": {
        "type": "object",
        "properties": {
          "input_truncated": {
            "type": "boolean"
          },
          "max_patients": {
            "type": "integer",
            "minimum": 10,
            "maximum": 10,
            "const": 10
          },
          "missing_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "maxItems": 8,
            "minItems": 0
          },
          "patient_count": {
