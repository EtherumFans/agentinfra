{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/principal-diagnosis-review@1.1.0",
  "manifest": {
    "name": "主诊断复核智能体",
    "version": "1.1.0",
    "description": "对编码员明确提供的主诊断初稿、候选集合和逐字证据执行确定性集合与证据完整性复核；不提取、分配、推荐或替换主诊断。",
    "category": "medical-coding",
    "category_display": "Coding and Revenue Cycle / 编码与收入周期",
    "icon": "Stethoscope",
    "tags": [
      "principal-diagnosis",
      "documented-draft-review",
      "evidence-first",
      "no-upcoding",
      "china-hospital"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "human_review": "required",
    "hidden_from_hub": false,
    "use_case": "coding_revenue_cycle"
  },
  "system_prompt": "你是 iCoDer 受治理主诊断初稿证据复核智能体。只处理明确标签输入：审核目的、编码标准、编码版本、病案文档范围、编码员主诊断初稿、主诊断候选和选择依据。候选格式为 candidate_id|code|display|source_document|evidence_text；选择依据格式为 candidate_id|ADMISSION_REASON/MAIN_TREATMENT/RESOURCE_USE/HOSPITAL_APPROVED_OTHER|source_document|evidence_text。你只核对初稿是否存在于候选集合、逐项证据是否精确回链、依据是否引用已知候选及输入是否冲突。不得从病历提取新诊断，不得分配、选择、排序、推荐或替换主诊断，不得判断诊断成立、严重程度、病因、主要治疗、资源消耗、编码规则正确性或结算有效性。READY_FOR_CODER_REVIEW 只表示输入和证据结构完整，始终要求编码员人工复核，禁止提交和写回。",
  "model": null,
  "backend_provider": "icoder.governed-principal-diagnosis-review.v1",
  "backend_config": {},
  "experts": [],
  "tools": [],
  "permissions": {
    "key": "principal-diagnosis-draft-review",
    "name": "主诊断初稿证据复核默认权限",
    "description": "只读核对编码员初稿、候选集合和输入证据，不执行诊断选择、编码分配、提交或写回。",
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_submission_blocked": true,
    "production_writeback_blocked": true
  },
  "output_contract": {
    "schema_ref": "icoder/PrincipalDxReview/v11",
    "a2a_parts": [
      "DataPart"
    ],
    "required_fields": [
      "review_status",
      "review_purpose",
      "coding_standard",
      "documentation_scope",
      "documented_coding_draft",
      "candidates",
