          {
            "path": "documented_text",
            "operator": "non_empty"
          },
          {
            "path": "evidence_ref",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "payer_requirements_are_traceable",
        "for_each": "payer_policy.requirements",
        "when": [
          {
            "path": "documented_text",
            "operator": "present"
          }
