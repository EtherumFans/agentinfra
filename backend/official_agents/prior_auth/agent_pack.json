          {
            "path": "documented_text",
            "operator": "non_empty"
          },
          {
            "path": "evidence_ref",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "clinical_documentation_is_traceable",
        "for_each": "clinical_documentation",
