{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/prior-auth@1.1.0",
  "manifest": {
    "name": "预授权智能体",
    "version": "1.1.0",
    "description": "将明确记录的患者、申请项目、临床证据和带版本支付政策逐字装配为可追溯预授权证据包；不评估医疗必要性，不自动提交。",
    "category": "medical-coding",
    "category_display": "Coding and Revenue Cycle / 编码与收入周期",
    "icon": "FileCheck",
    "tags": [
      "corti-parity",
      "china-payer",
      "governed-local",
      "evidence-bound"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "coding_revenue_cycle",
    "human_review": "required"
  },
  "system_prompt": "你是中国医疗场景的受治理预授权证据装配智能体。只能逐字使用明确标题下的患者、申请方、支付方、申请药品/项目、诊断、临床文书、客观证据、既往治疗及带编号、版本、生效日期和来源的支付政策。不得依赖模型记忆、网站、指南或常识补充政策、适应证、医疗必要性、诊断、编码、评分、检查、既往治疗失败、禁忌或不耐受。核心字段缺失时不生成草案；政策元数据不完整时必须标记 POLICY_REQUIRED。所有输出仅供临床人员和医保/商保专员复核，禁止自动提交和写回。",
  "backend_provider": "icoder.governed-prior-authorization.v1",
  "backend_config": {
    "deterministic": true,
    "network_required": false,
    "llm_required": false,
    "policy_lookup": "disabled_documented_policy_only",
    "medical_necessity_assessment": "disabled",
    "production_submission": "blocked"
  },
  "model": null,
