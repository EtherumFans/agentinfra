    "field_relations": [
      {
        "id": "input_required_has_no_referral_draft",
        "when": [
          {
            "path": "referral_status",
            "operator": "equals",
            "value": "INPUT_REQUIRED"
          }
        ],
        "must": [
          {
            "path": "missing_required_fields",
            "operator": "non_empty"
          },
          {
            "path": "referral_letter_draft",
            "operator": "equals",
            "value": ""
          }
        ]
      },
      {
        "id": "partial_referral_identifies_supporting_gaps",
        "when": [
          {
            "path": "referral_status",
            "operator": "equals",
            "value": "PARTIAL"
          }
        ],
        "must": [
          {
            "path": "missing_required_fields",
            "operator": "empty"
          },
          {
            "path": "missing_supporting_items",
            "operator": "non_empty"
          },
          {
            "path": "referral_letter_draft",
            "operator": "non_empty"
          },
          {
            "path": "evidence_items",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "ready_referral_has_no_declared_gaps",
        "when": [
          {
            "path": "referral_status",
            "operator": "equals",
            "value": "READY_FOR_REVIEW"
          }
        ],
        "must": [
          {
            "path": "missing_required_fields",
            "operator": "empty"
          },
          {
            "path": "missing_supporting_items",
            "operator": "empty"
          },
          {
            "path": "referral_letter_draft",
            "operator": "non_empty"
          },
          {
            "path": "evidence_items",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "governed_referral_never_claims_inference_or_delivery",
        "when": [
          {
            "path": "draft_generation_status",
            "operator": "equals",
            "value": "VERBATIM_TEMPLATE_ASSEMBLY_ONLY"
          }
        ],
        "must": [
          {
            "path": "clinical_inference_performed",
            "operator": "equals",
            "value": false
          },
          {
            "path": "new_diagnosis_generated",
            "operator": "equals",
            "value": false
          },
          {
            "path": "new_treatment_recommended",
            "operator": "equals",
            "value": false
          },
          {
            "path": "external_knowledge_used",
            "operator": "equals",
            "value": false
          },
          {
            "path": "production_transmission_blocked",
            "operator": "equals",
            "value": true
          },
          {
            "path": "production_writeback_blocked",
            "operator": "equals",
            "value": true
          },
          {
            "path": "manual_review_required",
            "operator": "equals",
            "value": true
          }
        ]
      },
      {
        "id": "diagnostic_results_are_traceable",
        "for_each": "diagnostic_results",
        "when": [
          {
            "path": "documented_text",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "documented_text",
            "operator": "non_empty"
          },
          {
            "path": "evidence_ref",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "medications_are_traceable",
        "for_each": "medications",
        "when": [
          {
            "path": "documented_text",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "documented_text",
            "operator": "non_empty"
          },
          {
            "path": "evidence_ref",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "allergies_are_traceable",
        "for_each": "allergies",
        "when": [
          {
            "path": "documented_text",
            "operator": "present"
          }
        ],
        "must": [
          {
            "path": "documented_text",
            "operator": "non_empty"
          },
          {
            "path": "evidence_ref",
            "operator": "non_empty"
          }
        ]
      }
    ],
    "evidence_bindings": [
      {
        "id": "referral_evidence_matches_input",
        "for_each": "evidence_items",
        "text_path": "evidence_text",
        "span_path": "char_span"
      }
    ]
  },
  "permissions": {
    "key": "referral-gen-default",
    "name": "转诊生成智能体 默认权限",
    "description": "允许读取已脱敏且明确标注的转诊字段并本地装配草案；禁止推断、外部知识、自动发送和生产写回。",
    "tools": {},
    "production_writeback_blocked": true,
    "production_transmission_blocked": true,
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "clinical_review_required": true
  },
  "phi_redaction": "required",
  "context_required": false,
  "recorder_required": true,
  "metrics_required": true,
  "requirements": {
    "min_runtime_version": "1.0.0",
    "icoder_runtime_modules": []
  },
  "llm_capabilities": null,
  "non_goals": [
    "不作新诊断、分诊或治疗建议",
    "不自动预约、发送、传真或写回 EMR/HIS/区域转诊平台"
  ],
  "human_review_required_when": [
    "all referral drafts before transmission",
    "any required or supporting field is missing, duplicated, or contradictory"
  ],
  "a2a": {
    "protocol_version": "0.3",
    "endpoint": "/api/icoder/agents/referral-gen/v1/message:send",
    "discovery": "/api/icoder/agents",
    "agent_card_ref": "icoder/referral-gen@1.1.0"
  },
  "example_inputs": [
