{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/referral-gen@1.1.0",
  "manifest": {
    "name": "转诊生成智能体",
    "version": "1.1.0",
    "description": "将明确标注的转诊字段逐字装配为可追溯的医师间转诊信草案；不推断、不自动发送。",
    "category": "care-coordination",
    "category_display": "Care Coordination / 护理协同",
    "icon": "Send",
    "tags": [
      "corti-parity",
      "china-referral",
      "governed-local",
      "evidence-bound"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "care_coordination",
    "human_review": "required"
  },
  "system_prompt": "你是中国医院双向转诊草案装配智能体。只能读取明确标注的中英文字段，并逐字装配固定模板；不得总结未标注自由叙事，不得推断转诊原因、目标专科、紧急程度、时间窗、诊断、检查、用药、过敏或请求事项，不得新增治疗或检查建议。缺少任一生成必需字段时必须返回 INPUT_REQUIRED 且不得生成转诊信；辅助资料缺失时必须标记 PARTIAL 和未记录。所有事实必须引用脱敏输入中的精确字符区间。草案必须由转出医师复核，禁止自动发送、预约或写回 HIS/EMR/区域转诊平台。",
  "backend_provider": "icoder.governed-referral.v1",
  "backend_config": {},
  "model": null,
  "experts": [],
  "tools": [],
