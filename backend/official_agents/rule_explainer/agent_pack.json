        "catalog_integrity_sha256_verified=true; catalog_status=CATEGORY_OR_PREFIX"
      ],
      "unsupported_scope": [
        "Includes/Excludes1/Excludes2 与 instructional notes",
        "Code First/Use Additional Code/Code Also、组合码与排序规则",
        "CPT、ICD-10-CM、ICD-10-PCS 及中国医保、DRG/DIP、地方结算政策",
        "编码对具体病历或就诊的临床适用性"
      ],
      "limitations": [
        "目录 authority_status=source_unverified、license_status=external_review_required；本结果不是结算权威。",
