        "type": "string",
        "maxLength": 32768
      },
      "anesthesia": {
        "type": "string",
        "maxLength": 32768
      },
      "outcomes": {
        "type": "string",
        "maxLength": 32768
      },
      "complications": {
        "type": "string",
        "maxLength": 32768
      },
      "evidence_spans": {
        "type": "object",
        "properties": {
          "procedure": {
            "type": "string",
            "maxLength": 32768
          },
          "indications": {
            "type": "string",
            "maxLength": 32768
          },
          "comorbidities": {
            "type": "string",
            "maxLength": 32768
          },
          "operative_details": {
            "type": "string",
            "maxLength": 32768
          },
          "anesthesia": {
            "type": "string",
            "maxLength": 32768
          },
          "outcomes": {
            "type": "string",
            "maxLength": 32768
          },
          "complications": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "missing_fields": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 32768
        },
        "maxItems": 100
      },
      "manual_review_required": {
        "type": "boolean",
        "const": true
