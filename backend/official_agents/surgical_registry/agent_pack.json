  "phi_redaction": "required",
  "context_required": true,
  "recorder_required": true,
  "metrics_required": true,
  "requirements": {
    "min_runtime_version": "1.0.0",
    "icoder_runtime_modules": [
      "icoder_runtime.backends.governed_surgical_registry_provider"
    ]
  },
  "non_goals": [
    "不替代编码员 / 临床医生最终决策",
    "不自动写回 EMR/HIS"
  ],
  "human_review_required_when": [
    "all registry records before database submission",
    "a required field lacks direct source evidence or needs local registry mapping"
  ],
  "example_inputs": [
    {
      "title": "腹腔镜胆囊切除质控登记",
      "input_text": "手术记录：全麻下行腹腔镜胆囊切除术，术中见胆囊壁增厚并与网膜粘连，无胆管损伤，估计出血20ml。请提取登记字段并标出缺失项。",
      "extra": {
        "registry": "hospital_surgical_quality"
      }
    }
  ],
