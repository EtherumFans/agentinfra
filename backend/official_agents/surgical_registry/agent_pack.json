{
  "format_version": "1.2",
  "agent_type": "certified",
  "agent_ref": "icoder/surgical-registry@1.0.0",
  "manifest": {
    "name": "外科质控登记智能体",
    "version": "1.0.0",
    "description": "从手术记录/日志自动提取数据填入外科质量登记数据库。",
    "category": "quality",
    "category_display": "Clinical Evidence and Research / 临床循证",
    "icon": "ClipboardList",
    "tags": [
      "corti-parity",
      "china-surgical-quality"
    ],
    "maturity": "runnable",
    "production_ready": false,
    "hidden_from_hub": false,
    "use_case": "clinical_evidence",
    "human_review": "required"
  },
  "system_prompt": "你是中国医院外科质控登记智能体。只能从输入明确提供的手术记录、麻醉记录和出院记录提取登记字段，所有非空字段必须能回指原文；不得推断患者身份、手术日期、术者、术式分级、适应证、合并症、麻醉细节、并发症或结局。原文明示的麻醉方式（例如“全麻”）属于直接事实，必须填写 anesthesia；原文明示的阴性并发症事实（例如“无胆管损伤”）也属于已记录证据，必须填写 complications，不得当作缺失。missing_fields 必须且只能列出完全没有来源事实的字段；非空字段不得同时出现在 missing_fields。每个非空登记字段都必须在 evidence_spans 的同名键中提供可在输入原文逐字找到的引用。未提供字段写入 missing_fields，不得把缺失写成阴性。登记员审核前不得入库，manual_review_required 必须为 true。只输出一个严格 JSON 对象，键名必须逐字使用 procedure、indications、comorbidities、operative_details、anesthesia、outcomes、complications、evidence_spans、missing_fields、manual_review_required，不得包装在 fields 中或翻译键名。默认使用简体中文填写值。",
  "backend_provider": "icoder.governed-surgical-registry.v1",
  "backend_config": {
    "extraction_policy": "explicit-source-facts-only",
    "policy_version": "1.0.0"
  },
  "experts": [],
  "tools": [],
  "permissions": {
    "key": "surgical-registry",
    "name": "外科质控登记智能体 权限",
    "description": "从手术记录/日志自动提取数据填入外科质量登记数据库。",
    "no_upcoding": true,
    "no_inference": true,
    "evidence_required": true,
    "production_writeback_blocked": true
  },
  "output_contract": {
    "schema_ref": "icoder/SurgicalRegistryOutput/v4",
    "required_fields": [
      "procedure",
      "indications",
      "comorbidities",
      "operative_details",
      "anesthesia",
      "outcomes",
      "complications",
      "evidence_spans",
      "missing_fields",
      "manual_review_required"
    ],
    "field_types": {
      "procedure": "string",
      "indications": "string",
      "comorbidities": "string",
      "operative_details": "string",
      "anesthesia": "string",
      "outcomes": "string",
      "complications": "string",
      "evidence_spans": "object",
      "missing_fields": "array",
      "manual_review_required": "boolean"
    },
