    "field_relations": [
      {
        "id": "ready_triage_candidate_has_valid_reached_path",
        "when": [
          {
            "path": "assessment_status",
            "operator": "equals",
            "value": "READY_FOR_ONSITE_REVIEW"
          }
        ],
        "must": [
          {
            "path": "missing_information",
            "operator": "empty"
          },
          {
            "path": "input_conflicts",
            "operator": "empty"
          },
          {
            "path": "questionnaire_validation.valid",
            "operator": "equals",
            "value": true
          },
          {
            "path": "decision_path",
            "operator": "non_empty"
          },
          {
            "path": "protocol_candidate.reached",
            "operator": "equals",
            "value": true
          },
          {
            "path": "protocol_candidate.result_status",
            "operator": "equals",
            "value": "DEVELOPMENT_UNVERIFIED_PROTOCOL_CANDIDATE"
          }
        ]
      },
      {
        "id": "unreached_triage_candidate_is_not_assessed",
        "when": [
          {
            "path": "assessment_status",
            "operator": "not_equals",
            "value": "READY_FOR_ONSITE_REVIEW"
          }
        ],
        "must": [
          {
            "path": "acuity_level",
            "operator": "equals",
            "value": "NOT_ASSIGNED"
          },
          {
            "path": "protocol_candidate.result_status",
            "operator": "equals",
            "value": "NOT_ASSESSED"
          }
        ]
      },
      {
        "id": "governed_triage_never_infers_or_assigns_final_acuity",
        "when": [
          {
            "path": "review_method",
            "operator": "equals",
            "value": "EXPLICIT_ANSWER_DETERMINISTIC_QUESTIONNAIRE_PATH_REVIEW"
          }
        ],
        "must": [
          {
            "path": "transcript_extraction_performed",
            "operator": "equals",
            "value": false
          },
          {
            "path": "questionnaire_answer_inference_performed",
            "operator": "equals",
            "value": false
          },
          {
            "path": "clinical_inference_performed",
            "operator": "equals",
            "value": false
          },
          {
            "path": "medical_calculator_used",
            "operator": "equals",
            "value": false
          },
          {
            "path": "external_knowledge_used",
            "operator": "equals",
            "value": false
          },
          {
            "path": "final_acuity_assignment_performed",
            "operator": "equals",
            "value": false
          }
        ]
      },
      {
        "id": "governed_triage_always_requires_onsite_gate",
        "when": [
          {
            "path": "review_method",
            "operator": "equals",
            "value": "EXPLICIT_ANSWER_DETERMINISTIC_QUESTIONNAIRE_PATH_REVIEW"
          }
        ],
        "must": [
          {
            "path": "production_action_blocked",
            "operator": "equals",
            "value": true
          },
          {
            "path": "production_writeback_blocked",
            "operator": "equals",
            "value": true
          },
          {
            "path": "manual_review_required",
            "operator": "equals",
            "value": true
          }
        ]
      }
    ],
    "evidence_bindings": [
      {
        "id": "triage_evidence_items_match_input",
        "for_each": "evidence_items",
        "text_path": "text",
        "span_path": "char_span"
      }
    ]
  },
  "non_goals": [
    "不从护士患者访谈、自由文本或来源记录抽取、推断或补全问卷回答",
    "不验证医院本地问卷的临床有效性、授权、版本现行性或批准状态",
    "不计算 ESI、qSOFA、HEART、CURB-65 或其他临床评分",
    "不作诊断、检查建议、药物/剂量/操作建议或最终分诊级别分配",
    "不自动分流、转运、处置、出院、触发生产动作或写回 EMR/HIS"
  ],
