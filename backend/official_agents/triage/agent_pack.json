          },
          "question_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "valid",
          "errors",
          "question_count",
          "endpoint_count",
          "all_references_resolved",
          "cycle_free"
        ],
        "additionalProperties": false
      },
      "decision_path": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "answer_type": {
              "type": "string",
              "maxLength": 32768,
              "enum": [
                "boolean",
                "number",
                "enum"
              ]
            },
            "documented_value": {
              "type": "string",
              "maxLength": 32768
            },
            "evidence_ref": {
              "type": "string",
              "maxLength": 32768
            },
            "matched_branch_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "matched_operator": {
              "type": "string",
