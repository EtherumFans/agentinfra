        {"path": "missing_required_fields", "op": "nonempty"},
        {"path": "authorization_packet_draft", "op": "empty"},
        {"path": "policy_evaluation_status", "op": "equals", "value": "POLICY_NOT_PROVIDED"},
        {"path": "clinical_inference_performed", "op": "is_false"},
        {"path": "production_submission_blocked", "op": "is_true"}
      ]
    },
    {
      "agent_id": "procedure-extractor",
      "case_id": "planned-but-cancelled",
      "input_text": "病程记录：原拟行腹腔镜胆囊切除术，因患者拒绝已取消，本次住院未实施任何手术或操作。",
      "assertions": [
        {"path": "procedures", "op": "empty"},
        {"path": "non_billable_mentions", "op": "contains_any", "value": ["腹腔镜胆囊切除术"]},
        {"path": "non_billable_mentions", "op": "contains_any", "value": ["cancelled"]},
        {"path": "manual_review_required", "op": "is_true"},
        {"path": "issues_found", "op": "nonempty"}
      ]
    },
      {
        "agent_id": "referral-gen",
        "case_id": "insufficient-referral",
        "input_text": "仅记录‘建议转诊’，未提供转诊原因、目标专科、诊断、检查、当前治疗、紧急程度或附件。",
        "assertions": [
          {"path": "referral_status", "op": "equals", "value": "INPUT_REQUIRED"},
          {"path": "missing_required_fields", "op": "nonempty"},
          {"path": "referral_letter_draft", "op": "empty"},
          {"path": "clinical_inference_performed", "op": "is_false"},
          {"path": "production_transmission_blocked", "op": "is_true"}
        ]
      },
    {
      "agent_id": "rule-explainer",
      "case_id": "invalid-code-explanation",
      "input_text": "请解释ICD-10-CN编码ZZ99.99是否可直接赋码；未提供病历或目录版本。",
      "extra": {"code": "ZZ99.99", "code_system": "ICD-10-CN"},
      "assertions": [
        {"path": "assignable", "op": "is_false"},
        {"path": "limitations", "op": "nonempty"}
      ]
