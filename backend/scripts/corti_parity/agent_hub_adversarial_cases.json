    {
      "agent_id": "surgical-registry",
      "case_id": "registry-minimum-missing",
      "input_text": "记录只写‘术后返回病房’，未提供手术名称、指征、麻醉、术中发现、出血量、并发症或结局。",
      "assertions": [
        {"path": "missing_fields", "op": "nonempty"}
      ]
    },
    {
      "agent_id": "triage",
      "case_id": "missing-vitals",
      "input_text": "患者诉胸部不适，但未记录血压、心率、呼吸频率、SpO2、意识状态、疼痛性质或持续时间。",
      "extra": {"standard": "hospital_local_triage"},
      "assertions": [
        {"path": "assessment_status", "op": "equals", "value": "INPUT_REQUIRED"},
        {"path": "acuity_level", "op": "equals", "value": "NOT_ASSIGNED"},
        {"path": "protocol_candidate.reached", "op": "equals", "value": false},
        {"path": "missing_information", "op": "nonempty"},
        {"path": "uncertainty", "op": "nonempty"},
        {"path": "final_acuity_assignment_performed", "op": "equals", "value": false},
        {"path": "production_action_blocked", "op": "equals", "value": true}
