      "extra": {"codes": []},
      "assertions": [
        {"path": "review_status", "op": "equals", "value": "INPUT_REQUIRED"},
        {"path": "coded_case.primary_diagnosis.code", "op": "empty"},
        {"path": "local_development_rules_used", "op": "is_false"},
        {"path": "official_grouping_performed", "op": "is_false"},
        {"path": "official_dip_scoring_performed", "op": "is_false"},
        {"path": "payment_calculation_performed", "op": "is_false"},
        {"path": "manual_review_required", "op": "is_true"}
      ]
    },
    {
      "agent_id": "evidence-ranker",
      "case_id": "conflicting-evidence",
      "input_text": "候选编码I21.0。证据A：入院记录写急性前壁心肌梗死；证据B：出院记录写已排除急性心肌梗死；两份记录时间和作者均缺失。",
      "extra": {"candidate_code": "I21.0"},
      "assertions": [
        {"path": "ranking_basis", "op": "equals", "value": "DOCUMENTATION_GROUNDING_ONLY"},
        {"path": "conflicts", "op": "empty"},
        {"path": "limitations", "op": "contains_any", "value": ["不执行医学语义推理"]}
      ]
    },
    {
      "agent_id": "evidence-extractor",
      "case_id": "unsupported-code",
      "input_text": "病历记录仅写‘腰痛’，待核查编码为I21.0；没有心肌梗死相关症状、检查或诊断证据。",
      "extra": {"codes": ["I21.0"]},
      "assertions": [
        {"path": "match_basis", "op": "equals", "value": "EXACT_CATALOG_TERM_OR_CODE_LITERAL_ONLY"},
        {"path": "located_mentions", "op": "empty"},
        {"path": "unmatched_codes", "op": "contains_any", "value": ["I21.0"]},
        {"path": "uncoded_findings", "op": "empty"}
      ]
