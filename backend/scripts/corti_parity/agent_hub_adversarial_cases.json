        {"path": "safety_risks", "op": "nonempty"}
      ]
    },
    {
      "agent_id": "principal-diagnosis-review",
      "case_id": "ambiguous-principal-diagnosis",
      "input_text": "出院诊断列有肺炎和心力衰竭，但未提供入院原因、诊疗经过、资源消耗、检查证据或编码员初稿。请复核主诊断。",
      "assertions": [
        {"path": "review_status", "op": "equals", "value": "INPUT_REQUIRED"},
