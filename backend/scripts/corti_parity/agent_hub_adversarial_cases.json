      "assertions": [
        {"path": "query_used", "op": "equals", "value": "肾功能异常"},
        {"path": "source_version", "op": "contains_any", "value": ["source_unverified", "external_review_required"]},
        {"path": "manual_review_required", "op": "is_true"},
        {"path": "inclusion_exclusion_notes", "op": "nonempty"}
      ]
    },
    {
      "agent_id": "icu-summary",
      "case_id": "sparse-icu-note",
