      "assertions": [
        {"path": "summary_status", "op": "equals", "value": "INPUT_REQUIRED"},
        {"path": "organ_support", "op": "empty"},
        {"path": "medications", "op": "empty"},
        {"path": "evidence_items", "op": "empty"}
