        {"path": "diagnosis_extraction_performed", "op": "is_false"},
        {"path": "code_assignment_performed", "op": "is_false"},
        {"path": "principal_diagnosis_selection_performed", "op": "is_false"},
        {"path": "production_writeback_blocked", "op": "is_true"},
        {"path": "manual_review_required", "op": "is_true"},
        {"path": "review_method", "op": "equals", "value": "DOCUMENTED_DRAFT_EVIDENCE_AND_SET_CONSISTENCY_ONLY"}
      ]
    },
    {
      "agent_id": "prior-auth",
      "case_id": "missing-payer-criteria",
      "input_text": "拟申请某介入治疗预授权，但没有诊断证据、检查结果、既往治疗、支付方、统筹区或授权标准。",
      "assertions": [
