      "assertions": [
        {"path": "structuring_status", "op": "equals", "value": "INPUT_REQUIRED"},
        {"path": "diagnoses", "op": "empty"},
        {"path": "procedures", "op": "empty"},
        {"path": "treatment_course", "op": "empty"},
        {"path": "discharge_orders", "op": "empty"},
        {"path": "follow_up_recommendations", "op": "empty"},
        {"path": "evidence_items", "op": "empty"},
        {"path": "summary_generation_status", "op": "equals", "value": "VERBATIM_SECTION_REORGANIZATION_ONLY"},
        {"path": "icd_codes_assigned", "op": "is_false"},
        {"path": "medication_reconciliation_performed", "op": "is_false"},
        {"path": "clinical_inference_performed", "op": "is_false"},
        {"path": "production_writeback_blocked", "op": "is_true"},
        {"path": "manual_review_required", "op": "is_true"}
      ]
