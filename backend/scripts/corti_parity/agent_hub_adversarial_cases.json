        {"path": "follow_up", "op": "empty"},
        {"path": "warning_signs", "op": "empty"},
        {"path": "lifestyle", "op": "empty"},
        {"path": "missing_items", "op": "contains_any", "value": ["出院用药"]},
        {"path": "missing_items", "op": "contains_any", "value": ["复诊/随访计划"]},
        {"path": "missing_items", "op": "contains_any", "value": ["警示症状/返院提示"]},
        {"path": "missing_items", "op": "contains_any", "value": ["生活方式/家庭护理"]},
