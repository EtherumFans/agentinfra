{
  "feature": "medical-coding",
  "schema_version": 2,
  "description": "编码主界面 (Medical Coding page) — Phase 2 cycle 19 first UI target. Two Corti parity gaps: 字符计数 (real-time char/cost counter in input area header) and 分段高亮 (click code row → highlight evidence span in input panel).",
  "source_of_truth": "docs/corti-reverse-engineered/interactions/ai-studio-medical-coding_*.png + _final.html + feature-flows/ai-studio-medical-coding/*.png (Corti portal captures, 2026-07-01)",
  "checks": [
    {
      "id": "real_time_char_counter",
      "description": "Input area header shows a live char + cost estimate that updates on every keystroke (not just after Predict).",
      "static": {
        "tsx_path": "frontend/src/pages/MedicalCodingPage.tsx",
        "must_contain": [
          "charCount",
          "input.length",
          "costEstimate"
        ],
        "must_not_contain": [
          "// TODO: char counter"
        ],
        "imported": [],
        "jsx_used": []
      },
      "runtime": {}
    },
    {
      "id": "no_plain_textarea_in_page",
      "description": "Plain <textarea> in MedicalCodingPage is replaced by HighlightedTextarea component (proves the input panel was migrated to the overlay pattern).",
      "static": {
        "tsx_path": "frontend/src/pages/MedicalCodingPage.tsx",
        "must_contain": [
          "HighlightedTextarea"
        ],
        "must_not_contain": [
          "<textarea"
        ],
        "imported": [
          "HighlightedTextarea"
        ],
        "jsx_used": [
          "<HighlightedTextarea"
        ]
      },
      "runtime": {}
    },
    {
      "id": "highlighted_textarea_overlay_pattern",
      "description": "HighlightedTextarea component renders BOTH a textarea (input) AND a <pre> overlay (highlight display), shares INPUT_TEXT_CLASS for font-metric sync, and uses EvidenceHighlighter as JSX (not just imported).",
      "static": {
        "tsx_path": "frontend/src/components/medical-coding/HighlightedTextarea.tsx",
        "must_contain": [
          "INPUT_TEXT_CLASS",
          "EvidenceHighlighter",
          "aria-hidden",
          "onScroll",
          "pointer-events"
        ],
        "must_not_contain": [],
        "imported": [
          "EvidenceHighlighter"
        ],
        "jsx_used": [
          "<EvidenceHighlighter"
        ]
      },
      "runtime": {}
    },
    {
      "id": "evidence_highlighter_focused_state",
      "description": "EvidenceHighlighter accepts a focusedSpanIndex prop and renders a distinct class (bg-green) for the focused span vs default (bg-yellow) for others — matches Corti screenshot where clicked code's evidence shows in green.",
      "static": {
        "tsx_path": "frontend/src/components/medical-coding/EvidenceHighlighter.tsx",
        "must_contain": [
          "focusedSpanIndex",
          "bg-green",
          "bg-yellow"
        ],
        "must_not_contain": [],
        "imported": [],
        "jsx_used": []
      },
      "runtime": {}
    },
    {
      "id": "i18n_keys_added",
      "description": "Two new i18n keys (charCount, costEstimate) added to BOTH zh-CN and en-US locale objects in locales.ts. Parity test enforces this automatically.",
      "static": {
        "tsx_path": "frontend/src/i18n/locales.ts",
        "must_contain": [
          "charCount: '",
          "costEstimate: '"
        ],
        "must_not_contain": [],
        "imported": [],
        "jsx_used": []
      },
      "runtime": {}
    },
    {
      "id": "char_counter_live",
      "description": "Runtime (Playwright): typing in the input updates [data-testid=char-counter] text per keystroke (not gated on Predict).",
      "static": {},
      "runtime": {
        "kind": "playwright",
        "auth": "setup",
        "test_name": "char counter updates per keystroke",
        "steps": [
          {"action": "goto", "url": "/ai-studio/medical-coding"},
          {"action": "wait_for", "selector": "[data-testid=char-counter-input]", "state": "visible", "timeout_ms": 10000},
          {"action": "fill", "selector": "[data-testid=char-counter-input]", "value": "Patient has heart failures"},
          {"action": "expect_text", "selector": "[data-testid=char-counter]", "contains": "26"}
        ]
      }
    },
    {
      "id": "click_code_highlights_evidence",
      "description": "Code table row carries data-testid='code-row-{i}' AND the row's onClick calls setFocusedSpanIndex so the focused state flows down to EvidenceHighlighter (bg-green). End-to-end: dataEvidences(result) reads result.evidences which is now populated by RuntimeRunResult.from_runner_output via the cycle-22 markdown evidence parser (parse_evidences_from_markdown).",
      "static": {
        "tsx_path": "frontend/src/pages/MedicalCodingPage.tsx",
        "must_contain": [
          "data-testid={`code-row-",
          "setFocusedSpanIndex"
        ],
        "must_not_contain": [],
        "imported": [],
        "jsx_used": []
      },
      "runtime": {
        "kind": "playwright",
        "auth": "setup",
        "test_name": "click code row highlights evidence in green",
        "test_timeout_ms": 120000,
        "steps": [
          {"action": "goto", "url": "/ai-studio/medical-coding"},
          {"action": "wait_for", "selector": "[data-testid=char-counter-input]", "state": "visible", "timeout_ms": 10000},
          {"action": "fill", "selector": "[data-testid=char-counter-input]", "value": "Patient has chronic heart failure, NYHA class III."},
          {"action": "click", "selector": "[data-testid=predict-codes-btn]"},
          {"action": "wait_for", "selector": "[data-testid^=code-row-]", "state": "visible", "timeout_ms": 60000},
          {"action": "click", "selector": "[data-testid=code-row-0]"},
          {"action": "expect_count", "selector": "mark[class*='bg-green-200']", "min": 1}
        ]
      }
    }
  ]
}
