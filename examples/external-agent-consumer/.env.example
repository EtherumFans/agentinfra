# iCoDer External Agent Consumer — env vars
# Copy to .env and fill in. Or export these in your shell.

# iCoDer backend base URL (no trailing slash). Local dev default = http://localhost:8000
ICODER_BASE_URL=http://localhost:8000

# OAuth 2.0 client_credentials. Created in Console > API Clients.
# These are demo-only; rotate or revoke after testing.
ICODER_API_CLIENT_ID=your_client_id_here
ICODER_API_CLIENT_SECRET=your_client_secret_here

# Agent ID to invoke. Should be a Generic Agent (translator-blank / summarizer-blank
# or your own custom Agent) — NOT a MedCodER-coupled agent, to prove Goal B.
ICODER_AGENT_ID=translator-blank

# Input text to send to the agent.
ICODER_INPUT_TEXT=Hello world, this is a Sprint 2 Goal F verification call.
