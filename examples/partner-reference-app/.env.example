# iCoDer Partner Reference App — Environment Configuration
#
# Copy to .env and fill in real values. Real secrets MUST NOT be committed.
#
# This reference app shows the canonical pattern for a partner HIS/EMR backend
# that integrates iCoDer:
#
#   1. Server holds ICODER_API_CLIENT_SECRET in env (never shipped to browser)
#   2. Server exchanges client_credentials → access_token at token endpoint
#   3. Server passes the short-lived access_token to the browser widget
#   4. Widget uses token for /api/embedded + /api/v1/agents/{id}/run
#   5. Widget PHI stays in-memory; page reload wipes it (Phase 6 Gate 2)

# Where is your iCoDer tenant hosted?
# Local dev against this repo's backend:   http://localhost:8000
# Cloud:                                    https://{tenant_slug}.{region}.icoder.cloud
ICODER_BASE_URL=http://localhost:8000

# OAuth2 token endpoint. Standard path:
ICODER_TOKEN_URL=http://localhost:8000/api/oauth/realms/icoder/token

# API Client credentials issued by iCoDer Console (Phase 7 Gate 5).
# Partner admin creates a client in /api/clients, gets client_id (visible)
# and client_secret (shown ONCE). Secret MUST stay server-side.
ICODER_API_CLIENT_ID=
ICODER_API_CLIENT_SECRET=

# Organization (tenant) ID — multi-tenant routing in cloud mode.
ICODER_ORGANIZATION_ID=

# Agent this partner will invoke. Pick from:
#   medical-coding-agent | cdi | drg-analyzer | medcoder-coding-review
ICODER_AGENT_REF=medical-coding-agent

# Port this reference app listens on (the partner's HIS/EMR-side server).
PORT=4400
