{
  "info": {
    "name": "iCoDer Route-Truthful API Examples",
    "description": "Starter collection for the current public surface. Use docs/openapi/openapi.json for the complete contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "access_token", "value": ""},
    {"key": "agent_id", "value": "medical-coding-agent"},
    {"key": "run_id", "value": ""}
  ],
  "item": [
    {
      "name": "Agent Hub",
      "item": [
        {"name": "List Hub Agents", "request": {"method": "GET", "url": "{{base_url}}/api/icoder/agents/hub"}},
        {"name": "Tenant Readiness", "request": {"method": "GET", "url": "{{base_url}}/api/icoder/agents/hub/readiness"}},
        {"name": "List Project Agents", "request": {"method": "GET", "url": "{{base_url}}/api/rest/v1/agent_definitions"}}
      ]
    },
    {
      "name": "Agent Run",
      "item": [
        {
          "name": "Run Agent",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/agents/{{agent_id}}/run",
            "body": {"mode": "raw", "raw": "{\"input\":{\"text\":\"患者主诉与出院诊断文本\"},\"purpose_of_use\":\"treatment\"}", "options": {"raw": {"language": "json"}}}
          }
        },
        {"name": "Get Run", "request": {"method": "GET", "url": "{{base_url}}/api/v1/runs/{{run_id}}"}},
        {"name": "Run Trace", "request": {"method": "GET", "url": "{{base_url}}/api/runtime/runs/{{run_id}}/trace?format=timeline"}}
      ]
    },
    {
      "name": "Clinical Tools",
      "item": [
        {
          "name": "Medical Coding Predict",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/coding/predict",
            "body": {"mode": "raw", "raw": "{\"text\":\"患者主诉与出院诊断文本\",\"coding_systems\":[\"icd10cn\"]}", "options": {"raw": {"language": "json"}}}
          }
        },
        {
          "name": "Extract Facts",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v2/tools/extract-facts",
            "body": {"mode": "raw", "raw": "{\"context\":[{\"type\":\"text\",\"text\":\"患者主诉胸痛，既往高血压。\"}],\"outputLanguage\":\"zh-CN\"}", "options": {"raw": {"language": "json"}}}
          }
        }
      ]
    },
    {
      "name": "Experts",
      "item": [
        {"name": "List Experts", "request": {"method": "GET", "url": "{{base_url}}/api/v1/experts"}}
      ]
    }
  ]
}
