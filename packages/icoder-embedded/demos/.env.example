# iCoDer Partner Demo — Environment Configuration Template
# Phase 7 Gate 1 (§6.3)
#
# Copy to backend/.env (or set in your shell) and fill in real values.
# Real secrets MUST NOT be committed to the repository.
#
# The backend reads these env vars and injects them into GET /examples/config.js
# which the demo HTML loads before initializing the widget. The browser-facing
# config NEVER includes the API client secret — partners exchange the secret
# for a token via their own backend using OAuth2 client_credentials grant
# against /api/oauth/realms/{realm}/token (Gate 5 productizes this).

# Backend base URL where the partner's iCoDer tenant is hosted.
# Local dev:  http://localhost:8000
# Cloud:      https://{tenant_slug}.{region}.icoder.cloud
ICODER_BASE_URL=http://localhost:8000

# Agent reference for the demo to invoke by default.
# Options: medical-coding-agent | cdi | drg-analyzer | medcoder-coding-review
ICODER_AGENT_REF=medical-coding-agent

# API Client ID issued to this partner (visible to browser, low sensitivity).
# Gate 5 will provision real api_clients; for local dev, the demo falls back
# to Console JWT login so this can be blank.
ICODER_API_CLIENT_ID=

# Organization (tenant) ID. Used for multi-tenant routing in cloud mode.
# Local dev: blank (single-org)
ICODER_ORGANIZATION_ID=

# API Client Secret — NEVER set in browser-visible env.
# Partners MUST store this only in their own backend secret manager and
# exchange it for a token server-side via client_credentials.
# DO NOT add ICODER_API_CLIENT_SECRET here — Gate 5 handles secret flow.
