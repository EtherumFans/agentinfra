{
  "name": "@icoder/sdk",
  "version": "1.0.0-beta.50",
  "description": "iCoDer JavaScript SDK for a medical AI agent platform serving Chinese hospitals",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk-adapter": {
      "types": "./dist/ai-sdk-adapter.d.ts",
      "import": "./dist/ai-sdk-adapter.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["icoder", "medical", "coding", "icd-10", "ai", "healthcare", "sdk"],
  "license": "MIT",
  "engines": {"node": ">=20"},
  "dependencies": {"axios": "^1.7.0"},
  "peerDependencies": {
    "@a2a-js/sdk": ">=1.0.0 <2.0.0",
    "ai": ">=6.0.0 <8.0.0"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.0.1",
    "ai": "7.0.77",
    "typescript": "^5.9.3"
  }
}
