{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icoder.cloud/schemas/a1c3/document-ingestion.schema.json",
  "title": "DocumentIngestionRequest",
  "description": "iCoDer A1C.3 — Standard Document Ingestion Request (per PDF A1C.3 §七 8 doc types).",
  "type": "object",
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/Document"}
    },
    "idempotency_key": {
      "type": ["string", "null"],
      "maxLength": 255,
      "description": "Optional batch-level idempotency key. Per-document source_doc_id provides fine-grained dedup."
    }
  },
  "$defs": {
    "Document": {
      "type": "object",
      "required": ["doc_type", "content"],
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "type": "string",
          "enum": [
            "discharge-summary",
            "admission-record",
            "discharge-record",
            "operation-record",
            "progress-note",
            "lab-result",
            "imaging-report",
            "order"
          ],
          "description": "Per PDF A1C.3 §七 8 doc types."
        },
        "title": {
          "type": "string",
          "maxLength": 256,
          "default": ""
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "Raw text content OR JSON-stringified structured payload."
        },
        "content_format": {
          "type": "string",
          "enum": ["text", "json"],
          "default": "text"
        },
        "doc_order": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based ordering within the encounter."
        },
        "source_doc_id": {
          "type": ["string", "null"],
          "maxLength": 128,
          "description": "HIS/EMR-side document ID for idempotency tracking."
        },
        "source_version": {
          "type": ["string", "null"],
          "maxLength": 32,
          "description": "Document version label (e.g. v1, v2). Enables scenario 7 (document version update)."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional doc-type-specific structured metadata (e.g. operation_date for operation-record)."
        }
      }
    }
  }
}
