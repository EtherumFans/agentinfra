{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icoder.cloud/schemas/a1c3/result-callback.schema.json",
  "title": "ResultCallbackPayload",
  "description": "iCoDer A1C.3 — Standard Result Write-back (per PDF A1C.3 §七 10 fields). iCoDer POSTs this to HIS/EMR webhook URL on run completion.",
  "type": "object",
  "required": [
    "delivery_id",
    "event",
    "trace_id",
    "organization_id",
    "patient_context_id",
    "run_id",
    "completed_at",
    "result",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "delivery_id": {
      "type": "string",
      "format": "uuid",
      "description": "Webhook delivery UUID. HIS must dedupe on this field (scenario 15)."
    },
    "event": {
      "type": "string",
      "enum": ["run.completed", "run.failed", "review.completed"]
    },
    "trace_id": {
      "type": "string",
      "description": "W3C traceparent for end-to-end tracing.",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$",
      "description": "iCoDer internal org ID."
    },
    "patient_context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$",
      "description": "The patient context this run belongs to."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$",
      "description": "The agent run that produced these results."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": ["string", "null"],
      "maxLength": 255,
      "description": "Echoes the original /api/agent_run Idempotency-Key, if provided."
    },
    "result": {
      "type": "object",
      "description": "Result payload; shape depends on `event`.",
      "oneOf": [
        {"$ref": "#/$defs/RunCompletedResult"},
        {"$ref": "#/$defs/RunFailedResult"},
        {"$ref": "#/$defs/ReviewCompletedResult"}
      ]
    },
    "failure_reason": {
      "type": ["string", "null"],
      "description": "Populated when event=run.failed or webhook delivery itself failed (scenario 14)."
    },
    "version": {
      "type": "string",
      "description": "Schema version. Current: 1.0.0.",
      "default": "1.0.0"
    }
  },
  "$defs": {
    "RunCompletedResult": {
      "type": "object",
      "required": ["coding_suggestions", "cdi_suggestions", "evidence", "confidence", "rule_basis", "review_status", "reviewer"],
      "properties": {
        "coding_suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code_system", "code", "display", "primary"],
            "properties": {
              "code_system": {"type": "string", "enum": ["ICD-10-CN", "ICD-9-CM-3"]},
              "code": {"type": "string"},
              "display": {"type": "string"},
              "primary": {"type": "boolean"}
            }
          },
          "description": "编码建议 (PDF field 1)"
        },
        "cdi_suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gap_type": {"type": "string"},
              "description": {"type": "string"},
              "suggested_query": {"type": "string"}
            }
          },
          "description": "CDI 建议 (PDF field 2)"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {"type": "string"},
              "doc_id": {"type": "string"},
              "snippet": {"type": "string"},
              "char_span": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}
            }
          },
          "description": "证据来源 (PDF field 3)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "置信度 (PDF field 4)"
        },
        "rule_basis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {"type": "string"},
              "rule_set": {"type": "string", "enum": ["medical_coding", "drg_dip", "insurance_audit", "charge_compliance", "document_evidence"]},
              "verdict": {"type": "string", "enum": ["PASS", "WARN", "FAIL"]}
            }
          },
          "description": "规则依据 (PDF field 5)"
        },
        "review_status": {
          "type": "string",
          "enum": ["auto_approved", "manual_review_required", "manual_review_passed", "manual_review_rejected"],
          "description": "人工审核状态 (PDF field 6)"
        },
        "reviewer": {
          "type": ["string", "null"],
          "description": "审核人 user ID (PDF field 7). Null until manual review completed."
        }
      }
    },
    "RunFailedResult": {
      "type": "object",
      "required": ["error_code", "error_message"],
      "properties": {
        "error_code": {"type": "string"},
        "error_message": {"type": "string"},
        "upstream_provider": {"type": ["string", "null"], "description": "e.g. deepseek / azure-openai / kms"},
        "retry_after_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 3600}
      }
    },
    "ReviewCompletedResult": {
      "type": "object",
      "required": ["reviewer_id", "decision", "decided_at"],
      "properties": {
        "reviewer_id": {"type": "string"},
        "decision": {"type": "string", "enum": ["approved", "rejected", "deferred"]},
        "decided_at": {"type": "string", "format": "date-time"},
        "comment": {"type": ["string", "null"]}
      }
    }
  }
}
