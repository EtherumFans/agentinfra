      }
    }
  },
  "schema_provenance": {
    "phase": "A1C.6",
    "pdf_reference": "§十",
    "audit_log_model": "backend/app/models/audit_log.py:AuditLog",
    "audit_middleware": "backend/app/middleware/audit.py:audit_middleware",
    "redactor": "backend/app/services/audit_detail_redactor.py",
    "tenant_classifier": "backend/app/services/legacy_tenancy_attribution.py",
    "authz_gates": [
      "backend/app/api/deps.py:get_current_user",
      "backend/app/api/deps.py:get_current_organization",
      "backend/app/api/deps.py:get_current_user_or_oauth_client",
      "backend/app/services/data_policy.py:region_allowed_providers",
      "backend/app/services/data_policy.py:egress_decision"
    ]
  }
}
